/* 夸克网盘 · 全局样式（Quark TV 风格：深色底 + 左侧导航 + 大卡片） */

.page {
  background-color: #0c0f14;
  color: #f4f7fb;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 24rpx;
}

.scroll {
  flex: 1;
}

.shell {
  flex-direction: row;
  flex: 1;
  height: 100%;
}

.row {
  flex-direction: row;
  align-items: center;
}

.col {
  flex-direction: column;
}

.spacer {
  flex: 1;
}

/* ---------- 左侧导航 ---------- */

.rail {
  width: 236rpx;
  height: 100%;
  flex-shrink: 0;
  flex-direction: column;
  background-color: #141922;
  border-radius: 24rpx;
  padding: 26rpx 18rpx;
  margin-right: 24rpx;
}

.brand {
  flex-direction: row;
  align-items: center;
  padding: 0 10rpx 22rpx;
}

.brand-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
}

.brand-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #f4f7fb;
  margin-left: 14rpx;
}

.nav-item {
  flex-direction: row;
  align-items: center;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.nav-on {
  background-color: #1d3b3a;
}

.nav-ico {
  width: 30rpx;
  height: 30rpx;
  border-radius: 9rpx;
  background-color: #2a3342;
  margin-right: 16rpx;
}

.nav-ico-on {
  background-color: #33d6c0;
}

.nav-label {
  font-size: 27rpx;
  color: #9aa7b8;
}

.nav-label-on {
  color: #ffffff;
  font-weight: bold;
}

.rail-foot {
  flex-direction: column;
  padding: 16rpx 10rpx 0;
}

.rail-user {
  font-size: 24rpx;
  color: #f4f7fb;
  font-weight: bold;
}

/* ---------- 主区域 ---------- */

.main {
  flex: 1;
  height: 100%;
  flex-direction: column;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #e8edf5;
}

.section-sub {
  font-size: 23rpx;
  color: #7d8a9c;
  margin-top: 6rpx;
}

.topbar {
  flex-direction: row;
  align-items: center;
  padding: 0 4rpx 18rpx;
  flex-shrink: 0;
}

.topbar-title {
  flex: 1;
  flex-direction: column;
}

.top-actions {
  flex-direction: row;
  align-items: center;
}

/* ---------- 卡片与按钮 ---------- */

.card {
  background-color: #141922;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #e8edf5;
  margin-bottom: 12rpx;
}

.hero {
  flex-direction: row;
  align-items: center;
  background-color: #151c27;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 18rpx;
}

.hero-logo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 28rpx;
  margin-right: 32rpx;
}

.hero-info {
  flex: 1;
  flex-direction: column;
}

.hero-kicker {
  font-size: 21rpx;
  font-weight: bold;
  color: #33d6c0;
  letter-spacing: 2rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-top: 6rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: #93a0b4;
  margin-top: 8rpx;
}

.actions {
  flex-direction: row;
  margin-top: 18rpx;
}

.action-card {
  flex: 1;
  flex-direction: row;
  align-items: center;
  background-color: #141922;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-right: 16rpx;
}

.action-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: #1d2836;
  margin-right: 18rpx;
  align-items: center;
  justify-content: center;
}

.action-ico-on {
  background-color: #33d6c0;
}

.action-ico-blue {
  background-color: #2f7bff;
}

.action-ico-gray {
  background-color: #2a3342;
}

.action-ico-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
}

.action-ico-text-dark {
  color: #062420;
}

.action-info {
  flex: 1;
  flex-direction: column;
}

.action-title {
  font-size: 27rpx;
  font-weight: bold;
  color: #f4f7fb;
}

.action-sub {
  font-size: 21rpx;
  color: #7d8a9c;
  margin-top: 4rpx;
}

.btn {
  height: 72rpx;
  padding: 0 32rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  background-color: #33d6c0;
  color: #062420;
  font-size: 25rpx;
  font-weight: bold;
}

.btn-ghost {
  background-color: #222a36;
  color: #e8edf5;
}

.btn-on {
  background-color: #2f7bff;
  color: #ffffff;
}

.btn-sm {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 23rpx;
  border-radius: 14rpx;
}

.chip {
  height: 60rpx;
  padding: 0 26rpx;
  margin-left: 12rpx;
  border-radius: 30rpx;
  background-color: #1d2531;
  color: #c3ccda;
  font-size: 23rpx;
  font-weight: bold;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.chip-on {
  background-color: #33d6c0;
  color: #062420;
}

.chip-accent {
  background-color: #2f7bff;
  color: #ffffff;
}

/* ---------- 文件列表 ---------- */

.file-row {
  flex-direction: row;
  align-items: center;
  height: 108rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  margin-bottom: 12rpx;
  background-color: #141922;
}

.file-tile {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.file-info {
  flex: 1;
  flex-direction: column;
}

.fname {
  font-size: 27rpx;
  color: #eef2f8;
  font-weight: bold;
}

.fmeta {
  font-size: 21rpx;
  color: #7d8a9c;
  margin-top: 5rpx;
}

.file-action {
  font-size: 22rpx;
  color: #33d6c0;
  font-weight: bold;
  margin-left: 16rpx;
}

.tag {
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.tag-text {
  font-size: 19rpx;
  color: #ffffff;
  font-weight: bold;
}

.tag-dir { background-color: #2f7bff; }
.tag-video { background-color: #0f9d7a; }
.tag-audio { background-color: #8b5cf6; }
.tag-image { background-color: #d97706; }
.tag-doc { background-color: #0891b2; }
.tag-file { background-color: #4b5563; }

.empty {
  padding: 70rpx 20rpx;
  align-items: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #c3ccda;
}

.hint {
  font-size: 23rpx;
  color: #7d8a9c;
  margin-top: 8rpx;
}

.error {
  font-size: 23rpx;
  color: #ff7272;
  margin-top: 12rpx;
}

.status {
  font-size: 23rpx;
  color: #33d6c0;
  margin-top: 10rpx;
}

.input {
  height: 80rpx;
  background-color: #1a212c;
  border-radius: 16rpx;
  padding: 0 22rpx;
  color: #eef2f8;
  font-size: 25rpx;
}

/* ---------- 底部按键提示 ---------- */

.hintbar {
  flex-direction: row;
  align-items: center;
  height: 42rpx;
  padding: 0 6rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.hintbar-text {
  font-size: 21rpx;
  color: #66738a;
  margin-right: 28rpx;
}
