<view class="page play-page">
  <view class="stage">
    <video wx:if="{{videoSrc}}"
           id="player"
           class="player"
           src="{{videoSrc}}"
           http-headers="{{headers}}"
           controls="{{true}}"
           autoplay="{{true}}"
           object-fit="contain"
           bindplay="onPlay"
           bindpause="onPause"
           bindended="onEnded"
           binderror="onError"
           bindwaiting="onWaiting"
           bindtimeupdate="onTime"/>

    <view wx:else class="stage-empty">
      <view class="stage-ring"/>
      <text class="stage-title">{{errMsg ? '播放失败' : '正在准备播放'}}</text>
      <text class="stage-text">{{errMsg || statusText || '正在获取播放地址…'}}</text>
      <view class="actions stage-actions">
        <button wx:if="{{errMsg}}" class="btn" bindtap="onRetry">重新获取</button>
        <button class="btn btn-ghost" bindtap="onBack">返回</button>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="play-info">
      <text class="play-title">{{displayName}}</text>
      <text class="fmeta">{{timeText}} · {{current ? current : '获取中'}}</text>
    </view>

    <view class="play-tools">
      <button class="btn btn-sm" bindtap="onToggle">{{playing ? '暂停' : '播放'}}</button>
      <button class="btn btn-sm btn-ghost" bindtap="onRetry">重新加载</button>
      <button class="btn btn-sm btn-ghost" bindtap="onBack">返回</button>

      <view wx:if="{{sources.length > 0}}" class="quality-row">
        <text class="quality-label">清晰度</text>
        <view wx:for="{{sources}}"
              wx:key="url"
              class="chip chip-sm {{current === item.label ? 'chip-on' : ''}}"
              data-index="{{index}}"
              bindtap="onPickSource">{{item.label}}</view>
      </view>
    </view>

    <text wx:if="{{statusText}}" class="status">{{statusText}}</text>
    <text wx:if="{{errMsg}}" class="error">{{errMsg}}</text>
    <text wx:if="{{directMode && !errMsg}}" class="hint">原始文件直链不支持拖动进度，建议优先使用转码清晰度。</text>
  </view>

  <view class="hintbar">
    <text class="hintbar-text">A 播放 / 暂停</text>
    <text class="hintbar-text">B 返回</text>
    <text class="hintbar-text">转码失败时自动回退原始文件</text>
  </view>
</view>
