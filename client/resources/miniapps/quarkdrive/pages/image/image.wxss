.stage {
  flex: 1;
  background-color: #05070a;
  border-radius: 20rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.photo {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.holder {
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.stage-ring {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  border: 6rpx solid #33d6c0;
  margin-bottom: 22rpx;
}

.stage-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #f4f7fb;
}

.stage-text {
  font-size: 23rpx;
  color: #8b98aa;
  margin-top: 10rpx;
}
