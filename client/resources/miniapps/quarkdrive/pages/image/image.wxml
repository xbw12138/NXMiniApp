<view class="page">
  <view class="topbar">
    <text class="crumb">{{name}}</text>
    <button class="btn btn-ghost topbtn" bindtap="onBack">返回</button>
  </view>

  <view class="stage">
    <image wx:if="{{src}}" class="photo" src="{{src}}" http-headers="{{headers}}"
           mode="aspectFit" bindtap="onBack"/>
    <view wx:else class="holder">
      <text class="hint">{{errMsg || '加载中…'}}</text>
      <button wx:if="{{errMsg}}" class="btn btn-ghost" bindtap="reload">重试</button>
    </view>
  </view>
</view>
