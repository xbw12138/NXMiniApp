<view class="page">
  <view class="topbar">
    <view class="topbar-title">
      <text class="section-title">{{name}}</text>
      <text class="section-sub">图片预览 · 点击图片或按 B 返回</text>
    </view>
    <view class="top-actions">
      <view class="chip" bindtap="reload">重新加载</view>
      <view class="chip" bindtap="onBack">返回</view>
    </view>
  </view>

  <view class="stage">
    <image wx:if="{{src}}" class="photo" src="{{src}}" http-headers="{{headers}}"
           mode="aspectFit" bindtap="onBack"/>
    <view wx:else class="holder">
      <view class="stage-ring"/>
      <text class="stage-title">{{errMsg ? '加载失败' : '正在加载图片'}}</text>
      <text class="stage-text">{{errMsg || '请稍候…'}}</text>
      <view class="actions">
        <button wx:if="{{errMsg}}" class="btn" bindtap="reload">重试</button>
        <button class="btn btn-ghost" bindtap="onBack">返回</button>
      </view>
    </view>
  </view>

  <view class="hintbar">
    <text class="hintbar-text">A / 点击图片 返回</text>
    <text class="hintbar-text">B 返回上一级</text>
  </view>
</view>
