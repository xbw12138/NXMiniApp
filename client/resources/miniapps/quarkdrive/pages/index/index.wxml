<view class="page">
  <view class="shell">
    <view class="rail">
      <view class="brand">
        <image class="brand-logo" src="/images/logo.png" mode="aspectFit"/>
        <text class="brand-name">夸克网盘</text>
      </view>

      <view class="nav-item nav-on">
        <view class="nav-ico nav-ico-on"/>
        <text class="nav-label nav-label-on">首页</text>
      </view>
      <view wx:if="{{logged}}" class="nav-item" bindtap="goList">
        <view class="nav-ico"/>
        <text class="nav-label">我的文件</text>
      </view>
      <view class="nav-item" bindtap="goSearch">
        <view class="nav-ico"/>
        <text class="nav-label">搜索文件</text>
      </view>
      <view class="spacer"/>
      <view class="rail-foot">
        <text class="rail-user">{{logged ? nickname : '未登录'}}</text>
      </view>
    </view>

    <view class="main">
      <view class="topbar">
        <view class="topbar-title">
          <text class="section-title">{{logged ? '我的网盘' : '登录夸克网盘'}}</text>
          <text class="section-sub">{{logged ? '浏览、搜索并直接播放云端视频' : '扫码登录，或在电脑端取 Cookie 粘贴登录'}}</text>
        </view>
        <view class="top-actions">
          <view wx:if="{{logged}}" class="chip">已登录</view>
        </view>
      </view>

      <scroll-view class="scroll" scroll-y="{{true}}">
        <view wx:if="{{checking}}" class="card">
          <text class="card-title">正在检查登录状态…</text>
          <text class="hint">请稍候</text>
        </view>

        <block wx:elif="{{logged}}">
          <view class="hero">
            <image class="hero-logo" src="/images/logo.png" mode="aspectFit"/>
            <view class="hero-info">
              <text class="hero-kicker">QUARK DRIVE</text>
              <text class="hero-title">欢迎回来，{{nickname}}</text>
              <text class="hero-sub">支持目录浏览、文件搜索、图片预览与多清晰度视频播放</text>
            </view>
            <button class="btn" autofocus="{{true}}" bindtap="goList">进入网盘</button>
          </view>

          <view class="actions">
            <view class="action-card" bindtap="goList">
              <view class="action-ico action-ico-on"><text class="action-ico-text action-ico-text-dark">文</text></view>
              <view class="action-info">
                <text class="action-title">我的文件</text>
                <text class="action-sub">逐级浏览全部目录</text>
              </view>
            </view>
            <view class="action-card" bindtap="goSearch">
              <view class="action-ico action-ico-blue"><text class="action-ico-text">搜</text></view>
              <view class="action-info">
                <text class="action-title">搜索文件</text>
                <text class="action-sub">按文件名模糊查找</text>
              </view>
            </view>
            <view class="action-card" bindtap="onLogout">
              <view class="action-ico action-ico-gray"><text class="action-ico-text">退</text></view>
              <view class="action-info">
                <text class="action-title">退出登录</text>
                <text class="action-sub">清除本机 Cookie</text>
              </view>
            </view>
          </view>

          <view class="card">
            <text class="card-title">操作提示</text>
            <text class="hint">方向键移动焦点，A 确认打开，B 返回上一级。</text>
            <text class="hint">视频默认自动播放转码流；失败会依次切换清晰度，最后回退到原始文件。</text>
            <text class="hint">图片点击即全屏预览；其他文件可获取下载链接并复制。</text>
          </view>
        </block>

        <block wx:else>
          <view class="card">
            <view class="row">
              <view class="qr-area">
                <view wx:if="{{qrState === 'ready'}}" class="qr-box">
                  <view style="width: {{qrSize}}rpx; height: {{qrSize}}rpx;">
                    <view class="qr-row" wx:for="{{qrRows}}" wx:key="index" style="height: {{qrMod}}rpx;">
                      <view class="qr-black" wx:for="{{item}}" wx:for-item="run" wx:key="index" style="margin-left: {{run.g}}rpx; width: {{run.w}}rpx; height: {{qrMod}}rpx;"></view>
                    </view>
                  </view>
                </view>
                <view wx:elif="{{qrState === 'loading'}}" class="qr-box qr-placeholder">
                  <text class="qr-tip">{{qrStatus}}</text>
                </view>
                <view wx:else class="qr-box qr-placeholder">
                  <text class="qr-tip qr-tip-err">{{qrStatus}}</text>
                  <button class="btn btn-sm" bindtap="onRefreshQr">刷新二维码</button>
                </view>
              </view>

              <view class="login-info">
                <text class="login-title">使用夸克 App 扫码登录</text>
                <text wx:if="{{qrState === 'ready'}}" class="status">{{qrStatus}} · 二维码约 2 分钟内有效</text>
                <text class="hint">打开夸克 App → 右上角「扫一扫」→ 确认登录。</text>
                <text class="hint">登录凭证仅保存在本机小程序缓存。</text>

                <view class="actions">
                  <view class="chip chip-accent" bindtap="onToggleCookie">{{showCookie ? '收起 Cookie 登录' : '使用 Cookie 登录'}}</view>
                  <view wx:if="{{qrState === 'expired' || qrState === 'error'}}" class="chip" bindtap="onRefreshQr">刷新二维码</view>
                </view>

                <block wx:if="{{showCookie}}">
                  <text class="hint">1. 电脑浏览器打开 pan.quark.cn 并登录</text>
                  <text class="hint">2. F12 打开开发者工具 → Network，刷新后任选一个请求</text>
                  <text class="hint">3. 复制请求头里的 Cookie 值粘贴到下方，按确认</text>
                  <input class="input" placeholder="粘贴 Cookie 后按确认登录" value="{{cookieInput}}" bindinput="onCookie" bindconfirm="onLogin"/>
                  <view class="actions">
                    <button class="btn" bindtap="onLogin">保存并登录</button>
                  </view>
                  <text wx:if="{{errMsg}}" class="error">{{errMsg}}</text>
                </block>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>

      <view class="hintbar">
        <text class="hintbar-text">A 确认</text>
        <text class="hintbar-text">B 返回</text>
        <text class="hintbar-text">方向键 移动焦点</text>
      </view>
    </view>
  </view>
</view>
