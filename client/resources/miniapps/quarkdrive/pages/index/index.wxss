.qr-area {
  width: 468rpx;
  flex-shrink: 0;
  margin-right: 36rpx;
}

.qr-box {
  width: 468rpx;
  height: 468rpx;
  background-color: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  align-items: center;
  justify-content: center;
}

.qr-row {
  flex-direction: row;
}

.qr-black {
  background-color: #000000;
}

.qr-tip {
  font-size: 24rpx;
  color: #3f4753;
  text-align: center;
}

.qr-tip-err {
  color: #d03050;
  margin-bottom: 16rpx;
}

.login-info {
  flex: 1;
  flex-direction: column;
  padding: 8rpx 4rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}
