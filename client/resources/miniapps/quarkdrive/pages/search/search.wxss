.topbar {
  flex-direction: row;
  align-items: center;
  padding: 4rpx 10rpx 16rpx;
  flex-shrink: 0;
}

.sinput {
  flex: 1;
  margin-top: 0;
  margin-right: 16rpx;
}

.topbtn {
  height: 56rpx;
  padding: 0 28rpx;
  margin-right: 0;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.sumline {
  padding: 0 10rpx 12rpx;
}

.row-item {
  flex-direction: row;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background-color: #1c1e22;
}

.fname {
  flex: 1;
  font-size: 26rpx;
  color: #e6e9ee;
}

.fmeta {
  font-size: 22rpx;
  color: #8b949e;
  margin-left: 16rpx;
}

.empty {
  padding: 60rpx 20rpx;
  align-items: center;
}
