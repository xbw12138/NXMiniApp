<view class="page">
  <view class="topbar">
    <view class="topbar-title">
      <text class="section-title">搜索文件</text>
      <text class="section-sub">{{subtitle}}</text>
    </view>
    <view class="top-actions">
      <view class="chip" bindtap="onBack">返回</view>
      <view class="chip" bindtap="goHome">首页</view>
    </view>
  </view>

  <view class="searchbar">
    <input class="input search-input"
           value="{{q}}"
           placeholder="输入文件名，如：电影、课程、.mp4"
           bindinput="onQuery"
           bindconfirm="onSearch"/>
    <button class="btn search-btn" bindtap="onSearch">搜索</button>
  </view>

  <scroll-view class="scroll" scroll-y="{{true}}">
    <view wx:for="{{items}}" wx:key="fid"
          class="file-row"
          autofocus="{{index === 0}}"
          data-fid="{{item.fid}}" data-name="{{item.name}}" data-kind="{{item.kind}}"
          data-size="{{item.sizeText}}" data-time="{{item.timeText}}"
          bindtap="onItem">
      <view class="tag tag-{{item.kind}}"><text class="tag-text">{{item.badge}}</text></view>
      <view class="file-info">
        <text class="fname">{{item.name}}</text>
        <text class="fmeta">{{item.metaText}}</text>
      </view>
      <text class="file-action">{{item.actionText}}</text>
    </view>

    <view wx:if="{{searched && items.length === 0 && !loading}}" class="empty">
      <text class="empty-title">{{errMsg || '没有找到匹配的文件'}}</text>
      <text class="hint">{{errMsg ? '检查 Cookie 是否失效后重试' : '试试更短的关键词'}}</text>
    </view>
  </scroll-view>

  <view class="hintbar">
    <text class="hintbar-text">A 打开 / 播放</text>
    <text class="hintbar-text">B 返回</text>
    <text class="hintbar-text">方向键 移动焦点</text>
  </view>
</view>
