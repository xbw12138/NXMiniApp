.topbar {
  flex-direction: row;
  align-items: center;
  padding: 4rpx 10rpx 16rpx;
  flex-shrink: 0;
}

.crumb {
  flex: 1;
  font-size: 26rpx;
  color: #e6e9ee;
  font-weight: bold;
}

.topbtn {
  height: 56rpx;
  padding: 0 20rpx;
  margin-right: 0;
  margin-left: 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.row-item {
  flex-direction: row;
  align-items: center;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background-color: #1c1e22;
}

.fname {
  flex: 1;
  font-size: 26rpx;
  color: #e6e9ee;
}

.fmeta {
  font-size: 22rpx;
  color: #8b949e;
  margin-left: 16rpx;
}

.empty {
  padding: 40rpx 20rpx;
  align-items: center;
}

.pager {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 24rpx;
  gap: 24rpx;
}
