/* 五子棋 —— 木纹棋盘主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #101319;
  padding: 30rpx 40rpx;
  color: #eceff5;
}

.top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.brand {
  flex-direction: row;
  align-items: flex-end;
}

.title {
  font-size: 54rpx;
  font-weight: bold;
  color: #f5f7fb;
  line-height: 1;
}

.subtitle {
  font-size: 22rpx;
  color: #717b8c;
  margin-left: 16rpx;
  margin-bottom: 4rpx;
}

.body {
  flex-direction: row;
  flex: 1;
  align-items: flex-start;
}

.board {
  width: 620rpx;
  height: 620rpx;
  flex-direction: column;
  padding: 10rpx;
  border-radius: 18rpx;
  background-color: #4a3823;
  border: 2rpx solid #5c472c;
}

.board-row {
  flex-direction: row;
  height: 40rpx;
  flex-shrink: 0;
}

.cell {
  width: 36rpx;
  height: 36rpx;
  margin: 2rpx;
  border-radius: 2rpx;
  background-color: #2f2417;
  color: #2f2417;
  font-size: 26rpx;
  padding: 0;
  line-height: 36rpx;
  text-align: center;
  border-width: 0;
}

.black {
  color: #14161b;
}

.white {
  color: #f4f1e8;
}

.last {
  background-color: #6b5230;
}

.win {
  background-color: #2f6b45;
}

.panel {
  flex: 1;
  margin-left: 44rpx;
  flex-direction: column;
}

.turns {
  flex-direction: row;
  margin-bottom: 18rpx;
}

.turn {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  background-color: #181d26;
  border: 2rpx solid #252d3a;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.turn-on {
  border-color: #4d7cff;
  background-color: #1b2437;
}

.turn-label {
  font-size: 20rpx;
  color: #758091;
}

.turn-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #eaf0fb;
  line-height: 1.4;
}

.dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 13rpx;
  margin-bottom: 6rpx;
}

.dot-black {
  background-color: #12141a;
  border: 2rpx solid #4a5262;
}

.dot-white {
  background-color: #f4f1e8;
  border: 2rpx solid #cfd6e2;
}

.mode {
  width: 100%;
  height: 84rpx;
  border-radius: 16rpx;
  background-color: #1c2330;
  border: 2rpx solid #2b3444;
  color: #cfd8e6;
  font-size: 26rpx;
  padding: 0;
  line-height: 80rpx;
  text-align: center;
  margin-bottom: 14rpx;
}

.mode-on {
  background-color: #243b2c;
  border-color: #3f9e6a;
  color: #a8ecc4;
  font-weight: bold;
}

.tools {
  flex-direction: row;
}

.tool {
  flex: 1;
  height: 80rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background-color: #202837;
  border: 2rpx solid #2b3648;
  color: #cdd7e6;
  font-size: 24rpx;
  padding: 0;
  line-height: 76rpx;
  text-align: center;
}

.tool-main {
  background-color: #4d7cff;
  border-color: #4d7cff;
  color: #ffffff;
  font-weight: bold;
}

.result {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background-color: #1a2620;
  border: 2rpx solid #2f4a3c;
  align-items: center;
}

.result-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #7fe3ab;
}

.result-sub {
  font-size: 22rpx;
  color: #8aa99a;
  margin-top: 6rpx;
}

.hint {
  flex-direction: column;
  margin-top: 20rpx;
}

.hint-line {
  font-size: 21rpx;
  color: #6b7587;
  line-height: 1.8;
}
