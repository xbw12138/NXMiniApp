<view class="page">
  <view class="top">
    <view class="brand">
      <text class="title">五子棋</text>
      <text class="subtitle">落子无悔 · 连成五子获胜</text>
    </view>
  </view>

  <view class="body">
    <view class="board">
      <view wx:for="{{rows}}" wx:for-item="row" wx:key="r" class="board-row">
        <button wx:for="{{row.cells}}" wx:for-item="c" wx:key="i"
                class="{{c.cls}}" data-i="{{c.i}}" bindtap="onCell">{{c.label}}</button>
      </view>
    </view>

    <view class="panel">
      <view class="turns">
        <view class="turn {{turnBlack ? 'turn-on' : ''}}">
          <view class="dot dot-black"/>
          <text class="turn-label">黑棋</text>
        </view>
        <view class="turn {{!turnBlack ? 'turn-on' : ''}}">
          <view class="dot dot-white"/>
          <text class="turn-label">白棋</text>
        </view>
      </view>

      <text class="hint-line" style="text-align: center; margin-bottom: 14rpx;">当前轮到 {{turnText}} · 已落 {{moves}} 手</text>

      <button class="mode {{mode === 'pve' ? 'mode-on' : ''}}" bindtap="onMode">
        {{mode === 'pve' ? '人机对战（你执黑）' : '双人轮流对战'}}
      </button>

      <view class="tools">
        <button class="tool" bindtap="onUndo">悔棋</button>
        <button class="tool tool-main" bindtap="reset">重新开始</button>
      </view>

      <view wx:if="{{over}}" class="result">
        <text class="result-text">{{resultText}}</text>
        <text class="result-sub">{{resultSub}}</text>
      </view>

      <view class="hint">
        <text class="hint-line">点击棋盘交叉点落子</text>
        <text class="hint-line">绿色格子是获胜的连珠</text>
        <text class="hint-line">人机模式你执黑先行</text>
      </view>
    </view>
  </view>
</view>
