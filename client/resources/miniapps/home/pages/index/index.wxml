<view class="page">
  <view class="topbar">
    <view class="search" bindtap="onSearch">
      <text class="search-text">搜索小程序</text>
    </view>
  </view>

  <view class="body">
    <view class="left">
      <swiper wx:if="{{banners.length > 0}}" class="banner" autoplay="{{true}}" interval="{{4000}}" duration="{{500}}">
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-item" data-target="{{item.id}}" bindtap="onNewsTap">
            <image class="banner-cover" src="{{item.cover_url}}" mode="aspectFill"/>
            <view class="banner-caption">
              <text class="banner-title">{{item.title}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <text class="section-title">推荐小程序</text>
      <scroll-view class="scroll" scroll-y="{{true}}">
        <view class="app-card" wx:for="{{featured}}" wx:key="id" data-id="{{item.id}}" bindtap="onLaunch">
          <image class="app-icon" src="{{item.icon_url}}" mode="aspectFill"/>
          <view class="app-meta">
            <text class="app-title">{{item.title}}</text>
            <text class="app-sub">{{item.category}} · v{{item.version}}</text>
          </view>
        </view>
        <view wx:if="{{featured.length === 0}}" class="empty">
          <text class="empty-text">服务端还没有推荐小程序</text>
        </view>
      </scroll-view>
    </view>

    <view class="right">
      <text class="section-title">最近使用</text>
      <scroll-view class="recent-scroll" scroll-y="{{true}}">
        <view class="recent-row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onLaunch">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-count">用过 {{item.count}} 次</text>
        </view>
        <view wx:if="{{recent.length === 0}}" class="empty">
          <text class="empty-text">还没有使用记录</text>
        </view>
      </scroll-view>

      <text class="section-title">最新资讯</text>
      <scroll-view class="scroll" scroll-y="{{true}}">
        <view class="news-item" wx:for="{{news}}" wx:key="id" data-target="{{item.id}}" bindtap="onNewsTap">
          <text class="news-title">{{item.title}}</text>
          <text class="news-summary">{{item.summary}}</text>
        </view>
        <view wx:if="{{news.length === 0}}" class="empty">
          <text class="empty-text">暂无资讯</text>
        </view>
      </scroll-view>

      <text class="status">{{status}}</text>
    </view>
  </view>
</view>
