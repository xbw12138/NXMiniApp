<view class="page">
  <image wx:if="{{banner.cover_url}}" class="wall" src="{{banner.cover_url}}" mode="aspectFill"/>
  <view class="scrim"></view>

  <view class="stage">
    <view class="main">
      <view class="topbar">
        <view class="brand-pill">
          <view class="brand-dot"></view>
          <text class="brand">Switch 小程序</text>
        </view>
        <view class="search" bindtap="onSearch">
          <text class="search-text">搜索小程序</text>
        </view>
        <view class="all-entry" bindtap="onAll">
          <text class="all-entry-text">全部</text>
        </view>
        <view class="spacer"></view>
      </view>

      <view wx:if="{{banner.title}}" class="feature" data-target="{{banner.id}}" bindtap="onNewsTap">
        <view class="feature-tag">
          <view class="tag-pill">
            <text class="tag-text">今日精选</text>
          </view>
          <view class="spacer"></view>
          <text wx:if="{{status}}" class="status">{{status}}</text>
          <text wx:else class="feature-hint">按 A 查看详情</text>
        </view>
        <view class="feature-title-box">
          <text class="feature-title">{{banner.title}}</text>
        </view>
        <view class="feature-sum-box">
          <text class="feature-sum">{{banner.summary}}</text>
        </view>
        <view wx:if="{{banners.length > 1}}" class="dots">
          <view class="dot {{index === bannerIndex ? 'dot-on' : ''}}" wx:for="{{banners}}" wx:key="id"/>
        </view>
      </view>

      <view class="news">
        <view class="feed-head">
          <text class="feed-title">资讯</text>
          <view class="spacer"></view>
          <text class="feed-hint">{{newsCount}} 条</text>
        </view>
        <view class="news-row">
          <view class="news-card" wx:for="{{stories}}" wx:key="id" data-target="{{item.id}}" bindtap="onNewsTap">
            <text class="news-no">{{item.no}}</text>
            <view class="news-title-box">
              <text class="news-title">{{item.title}}</text>
            </view>
            <view class="news-sum-box">
              <text class="news-sum">{{item.summary}}</text>
            </view>
          </view>
          <view wx:if="{{stories.length === 0}}" class="empty">
            <text class="empty-text">暂无资讯，稍后再来看看</text>
          </view>
        </view>
      </view>

      <view class="spacer"></view>

      <view class="dock">
        <view class="dock-row" wx:for="{{dockRows}}" wx:for-item="row">
          <view class="tile" wx:for="{{row.items}}" wx:key="id" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onDockTap">
            <view wx:if="{{item.add}}" class="tile-icon tile-icon-fallback">
              <text class="tile-all">+</text>
            </view>
            <image wx:elif="{{item.icon_url}}" class="tile-icon" src="{{item.icon_url}}" mode="aspectFill"/>
            <view wx:else class="tile-icon tile-icon-fallback">
              <text class="tile-initial">{{item.initial}}</text>
            </view>
            <view class="tile-name-box">
              <text class="tile-name">{{item.title}}</text>
            </view>
          </view>
          <view class="tile tile-blank" wx:for="{{row.blanks}}" wx:for-item="b"></view>
        </view>
      </view>
    </view>
  </view>
</view>
