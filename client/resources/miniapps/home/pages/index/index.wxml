<view class="page">
  <view class="topbar">
    <view class="brand">
      <text class="brand-name">Switch小程序</text>
    </view>

    <view class="topnav">
      <view class="nav nav-on" bindtap="onToday">
        <text class="nav-text nav-text-on">今日</text>
      </view>
      <view class="nav" bindtap="onAll">
        <text class="nav-text">全部</text>
      </view>
      <view class="nav" bindtap="onSearch">
        <text class="nav-text">搜索</text>
      </view>
    </view>

    <text class="date-text">{{dateText}}</text>
    <text wx:if="{{status}}" class="status">{{status}}</text>
    <view class="spacer"></view>
  </view>

  <view class="body">
    <view class="left">
      <!-- 今日精选：整块封面卡片，标题压在图上 -->
      <view class="hero-wrap">
        <image wx:if="{{hero.cover_url}}" class="hero-bg" src="{{hero.cover_url}}" mode="aspectFill"/>
        <view class="hero-scrim"></view>
        <view class="hero" bindtap="onHeroTap">
          <view class="hero-head">
            <text class="hero-eyebrow">今日精选</text>
          </view>

          <view class="spacer"></view>

          <view class="hero-title-box">
            <text class="hero-title">{{hero.title}}</text>
          </view>
          <view class="hero-sum-box">
            <text class="hero-sum">{{hero.summary}}</text>
          </view>
          <view class="hero-foot">
            <view class="dots">
              <view class="dot {{index === bannerIndex ? 'dot-on' : ''}}" wx:for="{{banners}}" wx:key="id"/>
            </view>
            <view class="spacer"></view>
            <text class="hero-more">阅读全文</text>
          </view>
        </view>
      </view>

      <!-- 资讯：横向三张编辑推荐卡（封面大图 + 压字） -->
      <view class="section">
        <view class="section-head">
          <text class="section-title">资讯</text>
          <text class="section-sub">编辑推荐</text>
          <view class="spacer"></view>
          <text class="section-meta">{{newsCount}} 篇</text>
        </view>
        <view class="story-row">
          <view class="story" wx:for="{{stories}}" wx:key="id" data-target="{{item.id}}" bindtap="onNewsTap">
            <image wx:if="{{item.cover_url}}" class="story-img" src="{{item.cover_url}}" mode="aspectFill"/>
            <view class="story-scrim"></view>
            <view class="story-body">
              <view class="story-title-box">
                <text class="story-title">{{item.title}}</text>
              </view>
              <view class="story-sum-box">
                <text class="story-sum">{{item.summary}}</text>
              </view>
            </view>
          </view>
          <view class="story story-blank" wx:for="{{storyBlanks}}" wx:for-item="b"></view>
          <view wx:if="{{stories.length === 0}}" class="empty">
            <text class="empty-text">暂无资讯，稍后再来看看</text>
          </view>
        </view>
      </view>
    </view>

    <view class="right">
      <!-- 快捷启动：最近用过的排前面，不足补精选 -->
      <view class="panel">
        <view class="panel-head">
          <text class="panel-title">快捷启动</text>
          <view class="spacer"></view>
          <text class="panel-hint">最近使用</text>
        </view>
        <view class="grid-row" wx:for="{{recentRows}}" wx:for-item="row">
          <view class="grid-tile" wx:for="{{row.items}}" wx:key="id" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onLaunch">
            <image wx:if="{{item.icon_url}}" class="grid-icon" src="{{item.icon_url}}" mode="aspectFill"/>
            <view wx:else class="grid-icon grid-icon-empty">
              <text class="grid-initial">{{item.initial}}</text>
            </view>
            <view class="grid-name-box">
              <text class="grid-name">{{item.title}}</text>
            </view>
          </view>
          <view class="grid-tile grid-blank" wx:for="{{row.blanks}}" wx:for-item="b"></view>
        </view>
      </view>

      <!-- 热门排行：按使用次数排 -->
      <view class="panel panel-grow">
        <view class="panel-head">
          <text class="panel-title">热门排行</text>
          <view class="spacer"></view>
          <text class="panel-hint">使用次数</text>
        </view>
        <view class="rank-list">
          <view class="rank" wx:for="{{hot}}" wx:key="id" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onLaunch">
            <text class="{{item.hot ? 'rank-no rank-no-hot' : 'rank-no'}}">{{item.no}}</text>
            <image wx:if="{{item.icon_url}}" class="rank-icon" src="{{item.icon_url}}" mode="aspectFill"/>
            <view wx:else class="rank-icon rank-icon-empty"></view>
            <view class="rank-body">
              <view class="rank-name-box">
                <text class="rank-name">{{item.title}}</text>
              </view>
              <view class="rank-meta-box">
                <text class="rank-meta">{{item.meta}}</text>
              </view>
            </view>
            <text class="rank-arrow">&gt;</text>
          </view>
        </view>
        <view wx:if="{{hot.length === 0}}" class="empty">
          <text class="empty-text">暂无排行</text>
        </view>
      </view>
    </view>
  </view>
</view>
