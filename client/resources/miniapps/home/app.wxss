/* Switch 横屏首页：App Store 式「今日」布局。
   左侧今日精选大卡 + 资讯，右侧快捷启动与热门排行。 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #06080d;
  color: #eef2f7;
  padding: 16rpx 22rpx 16rpx 22rpx;
}

.topbar {
  flex-direction: row;
  align-items: center;
  height: 56rpx;
  flex-shrink: 0;
}

.brand {
  flex-direction: row;
  align-items: center;
  margin-right: 20rpx;
}

.brand-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #f6f9fd;
}

.topnav {
  flex-direction: row;
  align-items: center;
}

.nav {
  height: 38rpx;
  padding: 0 18rpx;
  border-radius: 19rpx;
  align-items: center;
  justify-content: center;
  margin-right: 4rpx;
}

.nav-on {
  background-color: rgba(255, 255, 255, 0.12);
}

.nav-text {
  font-size: 19rpx;
  color: #98a4b4;
}

.nav-text-on {
  color: #ffffff;
  font-weight: bold;
}

.status {
  font-size: 16rpx;
  color: #e0ad6a;
  margin-left: 14rpx;
}

.date-text {
  font-size: 17rpx;
  color: #707c8c;
  margin-left: 16rpx;
}

.spacer {
  flex: 1;
}

.body {
  flex: 1;
  flex-direction: row;
  gap: 14rpx;
  margin-top: 12rpx;
}

.left {
  flex: 1.62;
  flex-direction: column;
  gap: 10rpx;
}

.right {
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

/* 精选小程序栏已移除，主图卡吃掉剩余高度。 */
.hero-wrap {
  height: 330rpx;
  flex: 1;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #12161f;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.hero-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background-color: rgba(3, 6, 11, 0.46);
}

.hero {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  padding: 22rpx 26rpx;
}

.hero-head {
  flex-direction: row;
  align-items: center;
}

.hero-eyebrow {
  font-size: 17rpx;
  font-weight: bold;
  color: #6fb2ff;
}

.hero-title-box {
  max-height: 100rpx;
  overflow: hidden;
}

.hero-title {
  font-size: 42rpx;
  font-weight: bold;
  line-height: 50rpx;
  color: #ffffff;
}

.hero-sum-box {
  height: 26rpx;
  overflow: hidden;
  margin-top: 6rpx;
}

.hero-sum {
  font-size: 19rpx;
  line-height: 26rpx;
  color: rgba(236, 242, 250, 0.74);
}

.hero-foot {
  flex-direction: row;
  align-items: center;
  height: 20rpx;
  margin-top: 12rpx;
}

.hero-more {
  font-size: 17rpx;
  color: #6fb2ff;
}

.dots {
  flex-direction: row;
  align-items: center;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: rgba(255, 255, 255, 0.3);
  margin-right: 6rpx;
}

.dot-on {
  width: 18rpx;
  background-color: #0a84ff;
}

/* 区块标题。 */
.section {
  flex-direction: column;
  flex-shrink: 0;
}

.section-head {
  flex-direction: row;
  align-items: center;
  height: 30rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #f0f4f9;
}

.section-sub {
  font-size: 16rpx;
  color: #6d7889;
  margin-left: 10rpx;
}

.section-meta {
  font-size: 16rpx;
  color: #6d7889;
}

/* 资讯：横向三张编辑推荐卡，封面铺满、标题压在底部。 */
.story-row {
  flex-direction: row;
  gap: 12rpx;
  margin-top: 10rpx;
}

.story {
  flex: 1;
  height: 152rpx;
  border-radius: 18rpx;
  background-color: #11161e;
  overflow: hidden;
}

.story-blank {
  background-color: rgba(17, 22, 30, 0.35);
}

.story-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background-color: #1a2029;
}

.story-scrim {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
  background-color: rgba(4, 7, 12, 0.42);
}

.story-body {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 14rpx;
  overflow: hidden;
}

.story-title-box {
  height: 28rpx;
  overflow: hidden;
}

.story-title {
  font-size: 21rpx;
  font-weight: bold;
  line-height: 28rpx;
  color: #ffffff;
}

.story-sum-box {
  height: 22rpx;
  overflow: hidden;
  margin-top: 3rpx;
  margin-bottom: 16rpx;
}

.story-sum {
  font-size: 15rpx;
  line-height: 20rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* 右侧面板。 */
.panel {
  flex-direction: column;
  background-color: #0c1016;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 22rpx;
  padding: 14rpx;
  flex-shrink: 0;
}

.panel-grow {
  flex: 1;
}

.panel-head {
  flex-direction: row;
  align-items: center;
  height: 28rpx;
  flex-shrink: 0;
}

.panel-title {
  font-size: 23rpx;
  font-weight: bold;
  color: #f0f4f9;
}

.panel-hint {
  font-size: 16rpx;
  color: #66717f;
}

/* 快捷启动 3×2 网格。 */
.grid-row {
  flex-direction: row;
  margin-top: 10rpx;
}

.grid-tile {
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 2rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.grid-blank {
  opacity: 0;
}

.grid-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 15rpx;
  background-color: #1a2029;
}

.grid-icon-empty {
  align-items: center;
  justify-content: center;
}

.grid-initial {
  font-size: 26rpx;
  font-weight: bold;
  color: #7d8a9b;
}

.grid-name-box {
  height: 22rpx;
  overflow: hidden;
  margin-top: 6rpx;
}

.grid-name {
  font-size: 17rpx;
  line-height: 22rpx;
  color: #aeb9c7;
  text-align: center;
}

/* 热门排行。 */
.rank-list {
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
}

.rank {
  flex-direction: row;
  align-items: center;
  height: 64rpx;
  border-radius: 12rpx;
  padding: 0 6rpx;
}

.rank-no {
  width: 36rpx;
  font-size: 21rpx;
  font-weight: bold;
  color: #4f5a67;
  text-align: center;
}

.rank-no-hot {
  color: #0a84ff;
}

.rank-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 11rpx;
  background-color: #1a2029;
  margin-left: 8rpx;
}

.rank-icon-empty {
  background-color: #1a2029;
}

.rank-body {
  flex: 1;
  flex-direction: column;
  margin-left: 12rpx;
  overflow: hidden;
}

.rank-name-box {
  height: 22rpx;
  overflow: hidden;
}

.rank-name {
  font-size: 19rpx;
  font-weight: bold;
  line-height: 22rpx;
  color: #e4ebf4;
}

.rank-meta-box {
  height: 18rpx;
  overflow: hidden;
  margin-top: 2rpx;
}

.rank-meta {
  font-size: 15rpx;
  line-height: 18rpx;
  color: #6e7988;
}

.rank-arrow {
  font-size: 22rpx;
  color: #48525f;
}

.empty {
  padding: 16rpx 4rpx;
}

.empty-text {
  font-size: 20rpx;
  color: #6b7481;
}

/* 搜索页。 */
.search-page {
  padding: 18rpx 28rpx 20rpx 28rpx;
}

.list-head {
  flex-direction: row;
  align-items: center;
  height: 30rpx;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.list-title {
  font-size: 22rpx;
  font-weight: bold;
  color: #dbe3ec;
}

.list-count {
  font-size: 17rpx;
  color: #5f6a77;
}

/* 精选：一行两个，8 个正好四行 */
.featured-grid {
  flex-direction: column;
}

.featured-row {
  flex-direction: row;
}

.featured-card {
  width: 700rpx;
  height: 132rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 18rpx;
  border-radius: 16rpx;
  background-color: #14171c;
  flex-direction: row;
  align-items: center;
}

.featured-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background-color: #1d242c;
  flex-shrink: 0;
}

.featured-icon-empty {
  background-color: #1d242c;
}

.featured-meta {
  flex: 1;
  flex-direction: column;
  margin-left: 16rpx;
  overflow: hidden;
}

.featured-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #eef2f7;
}

.featured-sub {
  font-size: 19rpx;
  color: #6f7883;
  margin-top: 6rpx;
  height: 24rpx;
  overflow: hidden;
}

.searchbar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: #1c2026;
  color: #eef1f5;
  font-size: 24rpx;
  padding: 0 26rpx;
}

.go {
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: 34rpx;
  background-color: #17c46c;
  align-items: center;
  justify-content: center;
  margin-left: 14rpx;
}

.go-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #06140d;
}

.results {
  flex: 1;
}

.app-card {
  flex-direction: row;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background-color: #191d22;
  margin-bottom: 10rpx;
}

.app-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.app-icon-empty {
  background-color: #1e262b;
}

.app-meta {
  flex: 1;
  flex-direction: column;
}

.app-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #eaeef3;
}

.app-sub {
  font-size: 20rpx;
  color: #7d8693;
  margin-top: 4rpx;
}

/* 顶栏「全部」入口。 */
.all-entry {
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background-color: rgba(8, 11, 15, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.all-entry-text {
  font-size: 21rpx;
  color: #d8dfe8;
}

/* 全部小程序页：一行四个，前端分页。 */
.all-page {
  padding: 18rpx 28rpx 16rpx 28rpx;
}

.all-head {
  flex-direction: row;
  align-items: center;
  height: 34rpx;
  margin-bottom: 14rpx;
  flex-shrink: 0;
}

.all-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #e6ebf2;
}

.all-count {
  font-size: 17rpx;
  color: #5f6a77;
}

.all-body {
  flex: 1;
}

.all-grid {
  flex-direction: column;
}

.all-row {
  flex-direction: row;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.all-card {
  flex: 1;
  height: 216rpx;
  padding: 12rpx 10rpx;
  border-radius: 16rpx;
  background-color: #14171c;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.all-card-blank {
  background-color: rgba(20, 23, 28, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.02);
}

.all-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #1d242c;
  flex-shrink: 0;
}

.all-icon-empty {
  background-color: #1d242c;
}

.all-name-box {
  height: 28rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.all-name {
  font-size: 22rpx;
  font-weight: bold;
  line-height: 28rpx;
  color: #e8edf3;
  text-align: center;
}

.all-sub-box {
  height: 22rpx;
  overflow: hidden;
  margin-top: 3rpx;
  margin-bottom: 16rpx;
}

.all-sub {
  font-size: 16rpx;
  line-height: 22rpx;
  color: #606b78;
  text-align: center;
}

.pager {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  flex-shrink: 0;
}

.pg-btn {
  height: 52rpx;
  padding: 0 34rpx;
  border-radius: 26rpx;
  background-color: #1c2026;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  align-items: center;
  justify-content: center;
}

.pg-off {
  opacity: 0.35;
}

.pg-text {
  font-size: 22rpx;
  color: #d5dce5;
}

.pg-info {
  font-size: 22rpx;
  color: #8b96a3;
  margin: 0 30rpx;
}

/* 详情确认弹窗：盖在列表上，确认后才启动小程序。 */
.modal-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(4, 6, 9, 0.78);
  align-items: center;
  justify-content: center;
}

.modal-card {
  width: 820rpx;
  padding: 30rpx 34rpx 26rpx 34rpx;
  border-radius: 24rpx;
  background-color: #161a20;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  flex-direction: column;
}

.modal-top {
  flex-direction: row;
  align-items: center;
}

.modal-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 26rpx;
  background-color: #1d242c;
  flex-shrink: 0;
}

.modal-icon-empty {
  background-color: #1d242c;
}

.modal-title-box {
  flex: 1;
  flex-direction: column;
  margin-left: 22rpx;
  overflow: hidden;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #f2f6fa;
}

.modal-meta {
  font-size: 20rpx;
  color: #7b8695;
  margin-top: 8rpx;
}

.modal-stats-box {
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  gap: 18rpx;
}

.modal-stats {
  font-size: 19rpx;
  color: #9aa6b4;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background-color: #1e242c;
}

.modal-desc-box {
  height: 84rpx;
  overflow: hidden;
  margin-top: 18rpx;
}

.modal-desc {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #b9c3ce;
}

.modal-actions {
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  margin-top: 22rpx;
  gap: 16rpx;
}

.modal-btn {
  height: 62rpx;
  padding: 0 40rpx;
  border-radius: 31rpx;
  background-color: #232a33;
  align-items: center;
  justify-content: center;
}

.modal-btn-primary {
  background-color: #17c46c;
}

.modal-btn-text {
  font-size: 24rpx;
  color: #dfe6ee;
}

.modal-btn-text-on {
  font-weight: bold;
  color: #06140d;
}

/* 资讯详情页。 */
.detail {
  flex: 1;
}

.detail-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
}

.detail-summary {
  font-size: 24rpx;
  color: #8b94a0;
  margin-bottom: 16rpx;
}

.detail-body {
  font-size: 25rpx;
  color: #d7dce2;
  line-height: 1.6;
}
