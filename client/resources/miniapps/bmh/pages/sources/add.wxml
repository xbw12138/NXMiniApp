<view class="page">
  <view class="topbar">
    <text class="brand">{{editId ? '编辑数据源' : '添加数据源'}}</text>
    <view class="spacer"/>
    <text class="step">{{editId ? '修改后保存即可' : '选类型 → 填信息 → 保存'}}</text>
  </view>

  <scroll-view class="scroll" scroll-y="{{true}}">
    <!-- 类型 -->
    <view class="type-grid">
      <view class="type-row" wx:for="{{typeRows}}" wx:for-item="row" wx:key="index">
        <view class="type-card {{type === item.key ? 'type-on' : ''}}"
              wx:for="{{row}}" wx:key="key" data-key="{{item.key}}" bindtap="onType">
          <view class="type-badge {{type === item.key ? 'type-badge-on' : ''}}">
            <text class="type-badge-text">{{item.badge}}</text>
          </view>
          <view class="type-meta">
            <text class="type-name">{{item.label}}</text>
            <text class="type-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 通用名称 -->
    <view class="field">
      <text class="field-label">名称</text>
      <input class="field-input" placeholder="留空则用类型名" value="{{name}}"
             data-field="name" bindinput="onInput"/>
    </view>

    <!-- Emby / Jellyfin -->
    <block wx:if="{{type === 'emby' || type === 'jellyfin'}}">
      <view class="field">
        <text class="field-label">服务器地址<text class="req">*</text></text>
        <input class="field-input" placeholder="192.168.1.100:8096" value="{{url}}"
               data-field="url" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">API Key</text>
        <input class="field-input" placeholder="后台「高级 → API 密钥」生成" value="{{token}}"
               data-field="token" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">用户名</text>
        <input class="field-input" placeholder="没有 API Key 时填用户名" value="{{username}}"
               data-field="username" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input class="field-input" placeholder="与用户名配对使用" password="{{true}}" value="{{password}}"
               data-field="password" bindinput="onInput"/>
      </view>
      <text class="hint">API Key 与「用户名 + 密码」二选一；填 Key 更快，也不会因改密码失效。</text>
    </block>

    <!-- WebDAV -->
    <block wx:if="{{type === 'webdav'}}">
      <view class="field">
        <text class="field-label">WebDAV 地址<text class="req">*</text></text>
        <input class="field-input" placeholder="192.168.1.100:5005" value="{{url}}"
               data-field="url" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">用户名</text>
        <input class="field-input" placeholder="NAS 账号" value="{{username}}"
               data-field="username" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input class="field-input" placeholder="NAS 密码" password="{{true}}" value="{{password}}"
               data-field="password" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">根路径</text>
        <input class="field-input" placeholder="默认 /" value="{{rootPath}}"
               data-field="rootPath" bindinput="onInput"/>
      </view>
      <text class="hint">群晖 / 极空间用 5005 端口，飞牛 fnOS 用 WebDAV 默认端口。</text>
    </block>

    <!-- SMB -->
    <block wx:if="{{type === 'smb'}}">
      <view class="field">
        <text class="field-label">地址<text class="req">*</text></text>
        <input class="field-input" placeholder="192.168.1.100 或 NAS 主机名" value="{{server}}"
               data-field="server" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">共享名</text>
        <input class="field-input" placeholder="例如 movies，可留空自动识别" value="{{share}}"
               data-field="share" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">根目录</text>
        <input class="field-input" placeholder="默认 /（共享根目录）" value="{{smbRoot}}"
               data-field="smbRoot" bindinput="onInput"/>
      </view>
      <view class="browse-row">
        <view class="browse-btn" bindtap="onBrowseDirs">
          <text class="browse-btn-text">{{dirOpen ? '重新读取目录' : '浏览目录…'}}</text>
        </view>
        <text class="hint hint-inline">只扫这个目录，不遍历整个共享</text>
      </view>

      <!-- 目录选择：逐级进入，选中后作为扫描根目录 -->
      <view wx:if="{{dirOpen}}" class="dir-panel">
        <view class="dir-head">
          <text class="dir-path">{{dirPath}}</text>
          <view class="dir-close" bindtap="onCloseDirs">
            <text class="dir-close-text">收起</text>
          </view>
        </view>
        <view wx:if="{{dirLoading}}" class="dir-empty">
          <text class="dir-empty-text">正在读取目录…</text>
        </view>
        <view wx:elif="{{dirError}}" class="dir-empty">
          <text class="dir-empty-text">{{dirError}}</text>
        </view>
        <block wx:else>
          <view wx:if="{{dirPath !== '/'}}" class="dir-row" bindtap="onParentDir">
            <text class="dir-name">返回上一级</text>
            <text class="dir-enter">上一级</text>
          </view>
          <view wx:for="{{dirs}}" wx:key="path" class="dir-row"
                data-path="{{item.path}}" bindtap="onEnterDir">
            <text class="dir-name">{{item.label}}</text>
            <text class="dir-enter">进入 ›</text>
          </view>
          <view wx:if="{{dirs.length === 0}}" class="dir-empty">
            <text class="dir-empty-text">没有子目录，可直接使用当前目录</text>
          </view>
          <view class="dir-use" bindtap="onUseDir">
            <text class="dir-use-text">使用当前目录</text>
          </view>
        </block>
      </view>
      <view class="field">
        <text class="field-label">用户名</text>
        <input class="field-input" placeholder="SMB 账号" value="{{username}}"
               data-field="username" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input class="field-input" placeholder="SMB 密码" password="{{true}}" value="{{password}}"
               data-field="password" bindinput="onInput"/>
      </view>
      <view class="field">
        <text class="field-label">域</text>
        <input class="field-input" placeholder="工作组 / 域，通常留空" value="{{domain}}"
               data-field="domain" bindinput="onInput"/>
      </view>
      <text class="hint">地址也可以直接粘贴 \\192.168.1.100\movies，会自动拆成地址与共享名。</text>
    </block>

    <!-- 阿里云盘 -->
    <block wx:if="{{type === 'aliyun'}}">
      <!-- 二维码面板放在登录框上方：点「扫码登录」后原地出现，不用再滚动找 -->
      <view wx:if="{{qrOpen}}" class="qr-panel">
        <view class="qr-head">
          <text class="qr-title">阿里云盘扫码登录</text>
          <!-- 面板出现时把焦点交给「收起」，避免焦点留在被顶下去的按钮上 -->
          <view class="dir-close" bindtap="onCloseQr" autofocus="true">
            <text class="dir-close-text">收起</text>
          </view>
        </view>
        <text wx:if="{{qrState === 'ready'}}" class="qr-status">{{qrStatus}}，约 2 分钟内有效</text>
        <view class="qr-area">
          <view wx:if="{{qrState === 'ready'}}" class="qr-box">
            <view style="width: {{qrSize}}rpx; height: {{qrSize}}rpx;">
              <view class="qr-row" wx:for="{{qrRows}}" wx:for-item="row" wx:key="index">
                <view class="qr-black" wx:for="{{row}}" wx:for-item="run" wx:key="index" style="{{run.s}}"></view>
              </view>
            </view>
          </view>
          <view wx:elif="{{qrState === 'confirmed'}}" class="qr-box qr-placeholder">
            <text class="qr-tip qr-tip-ok">{{qrStatus}}</text>
          </view>
          <view wx:elif="{{qrState === 'loading'}}" class="qr-box qr-placeholder">
            <text class="qr-tip">{{qrStatus}}</text>
          </view>
          <view wx:else class="qr-box qr-placeholder">
            <text class="qr-tip qr-tip-err">{{qrStatus}}</text>
            <view class="qr-refresh" bindtap="onRefreshQr">
              <text class="qr-refresh-text">刷新二维码</text>
            </view>
          </view>
        </view>
      </view>

      <view class="login-box">
        <view class="login-meta">
          <text class="login-title">阿里云盘账号</text>
          <text wx:if="{{loginToken || refreshToken}}" class="login-ok">已登录{{loginName ? '：' + loginName : ''}}</text>
          <text wx:else class="login-tip">未登录</text>
        </view>
        <view class="login-actions">
          <view class="browse-btn" bindtap="onQrLogin">
            <text class="browse-btn-text">{{qrOpen ? '收起二维码' : ((loginToken || refreshToken) ? '重新扫码登录' : '扫码登录')}}</text>
          </view>
          <text class="hint hint-inline">手机扫一扫即可，无需手动填 token</text>
        </view>
      </view>
    </block>

    <!-- 百度网盘 -->
    <block wx:if="{{type === 'baidu'}}">
      <view wx:if="{{qrOpen}}" class="qr-panel">
        <view class="qr-head">
          <text class="qr-title">百度网盘扫码登录</text>
          <view class="dir-close" bindtap="onCloseQr" autofocus="true">
            <text class="dir-close-text">收起</text>
          </view>
        </view>
        <text wx:if="{{qrState === 'ready'}}" class="qr-status">{{qrStatus}}，约 2 分钟内有效</text>
        <view class="qr-area">
          <view wx:if="{{qrState === 'ready'}}" class="qr-box">
            <view style="width: {{qrSize}}rpx; height: {{qrSize}}rpx;">
              <view class="qr-row" wx:for="{{qrRows}}" wx:for-item="row" wx:key="index">
                <view class="qr-black" wx:for="{{row}}" wx:for-item="run" wx:key="index" style="{{run.s}}"></view>
              </view>
            </view>
          </view>
          <view wx:elif="{{qrState === 'confirmed'}}" class="qr-box qr-placeholder">
            <text class="qr-tip qr-tip-ok">{{qrStatus}}</text>
          </view>
          <view wx:elif="{{qrState === 'loading'}}" class="qr-box qr-placeholder">
            <text class="qr-tip">{{qrStatus}}</text>
          </view>
          <view wx:else class="qr-box qr-placeholder">
            <text class="qr-tip qr-tip-err">{{qrStatus}}</text>
            <view class="qr-refresh" bindtap="onRefreshQr">
              <text class="qr-refresh-text">刷新二维码</text>
            </view>
          </view>
        </view>
      </view>

      <view class="login-box">
        <view class="login-meta">
          <text class="login-title">百度网盘账号</text>
          <text wx:if="{{loginCookie}}" class="login-ok">已登录</text>
          <text wx:elif="{{accessToken}}" class="login-tip">旧版 token 登录，建议重新扫码</text>
          <text wx:else class="login-tip">未登录</text>
        </view>
        <view class="login-actions">
          <view class="browse-btn" bindtap="onQrLogin">
            <text class="browse-btn-text">{{qrOpen ? '收起二维码' : (loginCookie ? '重新扫码登录' : '扫码登录')}}</text>
          </view>
          <text class="hint hint-inline">扫码登录网页版，播放会自动带上凭证</text>
        </view>
      </view>
    </block>

    <view wx:if="{{testState !== 'idle'}}" class="test-box test-{{testState}}">
      <text class="test-text">{{testText}}</text>
    </view>
  </scroll-view>

  <view class="footer">
    <text wx:if="{{errText}}" class="err-text">{{errText}}</text>
    <view class="footer-row">
      <button class="btn btn-ghost foot-btn" bindtap="onTest" disabled="{{testing}}">
        {{testing ? '连接中…' : '测试连接'}}
      </button>
      <button class="btn foot-btn" bindtap="onSave">{{editId ? '保存修改' : '添加数据源'}}</button>
    </view>
  </view>
</view>
