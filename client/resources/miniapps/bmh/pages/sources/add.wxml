<view class="page">
  <scroll-view class="scroll" scroll-y="{{true}}" style="height: 100%;">
    <!-- 数据源类型选择 -->
    <text class="section-title">选择数据源类型</text>
    <view class="type-grid">
      <view wx:for="{{types}}" wx:key="key"
            class="type-btn {{type === item.key ? 'type-on' : ''}}"
            data-key="{{item.key}}" bindtap="onType">
        <text class="type-text">{{item.label}}</text>
      </view>
    </view>

    <!-- 名称 -->
    <text class="section-title">名称</text>
    <input class="input" placeholder="给这个数据源起个名字" value="{{name}}"
           data-field="name" bindinput="onInput"/>

    <!-- Emby / Jellyfin -->
    <block wx:if="{{type === 'emby' || type === 'jellyfin'}}">
      <text class="section-title">服务器地址</text>
      <input class="input" placeholder="例如 http://192.168.1.100:8096" value="{{url}}"
             data-field="url" bindinput="onInput"/>
      <text class="section-title">用户名（可选，留空用 API Key）</text>
      <input class="input" placeholder="Emby 用户名" value="{{username}}"
             data-field="username" bindinput="onInput"/>
      <text class="section-title">密码</text>
      <input class="input" placeholder="Emby 密码" password="{{true}}" value="{{password}}"
             data-field="password" bindinput="onInput"/>
      <text class="section-title">API Key（可选，后台生成）</text>
      <input class="input" placeholder="Emby API Key" value="{{token}}"
             data-field="token" bindinput="onInput"/>
      <text class="hint">推荐在 Emby 后台「高级 → API 密钥」生成一个 Key 填入，无需密码。</text>
    </block>

    <!-- WebDAV -->
    <block wx:if="{{type === 'webdav'}}">
      <text class="section-title">WebDAV 地址</text>
      <input class="input" placeholder="例如 http://192.168.1.100:5005" value="{{url}}"
             data-field="url" bindinput="onInput"/>
      <text class="section-title">用户名</text>
      <input class="input" placeholder="WebDAV 用户名" value="{{username}}"
             data-field="username" bindinput="onInput"/>
      <text class="section-title">密码</text>
      <input class="input" placeholder="WebDAV 密码" password="{{true}}" value="{{password}}"
             data-field="password" bindinput="onInput"/>
      <text class="section-title">根路径（可选）</text>
      <input class="input" placeholder="默认 /" value="{{rootPath}}"
             data-field="rootPath" bindinput="onInput"/>
      <text class="hint">群晖：http://NAS_IP:5005  极空间：http://NAS_IP:5005  飞牛 fnOS：WebDAV 默认端口。</text>
    </block>

    <!-- SMB -->
    <block wx:if="{{type === 'smb'}}">
      <text class="section-title">服务器地址</text>
      <input class="input" placeholder="例如 192.168.1.100 或 NAS 主机名" value="{{server}}"
             data-field="server" bindinput="onInput"/>
      <text class="section-title">共享名</text>
      <input class="input" placeholder="例如 movies 或 video" value="{{share}}"
             data-field="share" bindinput="onInput"/>
      <text class="section-title">用户名</text>
      <input class="input" placeholder="SMB 用户名" value="{{username}}"
             data-field="username" bindinput="onInput"/>
      <text class="section-title">密码</text>
      <input class="input" placeholder="SMB 密码" password="{{true}}" value="{{password}}"
             data-field="password" bindinput="onInput"/>
      <text class="section-title">域（可选）</text>
      <input class="input" placeholder="工作组/域，通常留空" value="{{domain}}"
             data-field="domain" bindinput="onInput"/>
      <text class="hint">Windows 共享、群晖、飞牛、极空间等均支持 SMB。默认端口 445。</text>
    </block>

    <!-- 阿里云盘 -->
    <block wx:if="{{type === 'aliyun'}}">
      <text class="section-title">Refresh Token</text>
      <input class="input" placeholder="粘贴阿里云盘 refresh_token" value="{{refreshToken}}"
             data-field="refreshToken" bindinput="onInput"/>
      <text class="hint">获取方式：登录阿里云盘网页版，F12 → Application → Local Storage → token，复制 refresh_token 的值。</text>
      <text class="hint">refresh_token 有效期较长，可长期使用。</text>
    </block>

    <!-- 百度网盘 -->
    <block wx:if="{{type === 'baidu'}}">
      <text class="section-title">Access Token</text>
      <input class="input" placeholder="粘贴百度网盘 access_token" value="{{accessToken}}"
             data-field="accessToken" bindinput="onInput"/>
      <text class="hint">获取方式：通过百度网盘开放平台 OAuth 授权获取 access_token，有效期约 30 天。</text>
    </block>

    <!-- 操作按钮 -->
    <view class="row action-row">
      <button class="btn btn-ghost" bindtap="onTest" disabled="{{testing}}">
        {{testing ? '测试中…' : '测试连接'}}
      </button>
      <button class="btn" bindtap="onSave">保存</button>
    </view>
    <text wx:if="{{testResult === 'ok'}}" class="hint test-ok">✓ 连接测试通过</text>
  </scroll-view>
</view>
