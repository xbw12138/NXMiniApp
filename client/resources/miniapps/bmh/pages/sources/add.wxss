/* 添加 / 编辑数据源 */
.step {
  font-size: 21rpx;
  color: #6f7883;
}

/* 底部有固定操作栏，滚动区不能撑满整页，否则内容会被压到栏下面 */
.scroll {
  flex: 1;
  height: auto;
}

/* 类型选择：3 个一行，两行 */
.type-grid {
  flex-direction: column;
  margin-bottom: 6rpx;
}

.type-row {
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.type-card {
  width: 470rpx;
  height: 92rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background-color: #171a20;
  border: 2rpx solid #23272f;
  flex-direction: row;
  align-items: center;
}

.type-on {
  background-color: #2a1a1c;
  border: 2rpx solid #4a2a2c;
}

.type-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background-color: #23272f;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.type-badge-on {
  background-color: #ff3b30;
}

.type-badge-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #e8ebf0;
}

.type-meta {
  flex-direction: column;
  overflow: hidden;
}

.type-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #eef1f5;
}

.type-desc {
  font-size: 19rpx;
  color: #78818d;
  margin-top: 4rpx;
}

/* 表单 */
.field {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14rpx;
}

.field-label {
  width: 220rpx;
  font-size: 23rpx;
  color: #9aa1ab;
  flex-shrink: 0;
}

.req {
  font-size: 22rpx;
  color: #ff5c52;
}

.field-input {
  flex: 1;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background-color: #1a1d23;
  color: #eef1f5;
  font-size: 23rpx;
}

/* 测试结果 */
.test-box {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background-color: #191c22;
}

.test-text {
  font-size: 22rpx;
  color: #a9b2bd;
}

.test-ok {
  background-color: #12251a;
}

.test-ok .test-text {
  color: #3ddc84;
}

.test-fail {
  background-color: #2a1717;
}

.test-fail .test-text {
  color: #ff7a72;
}

/* 底部操作栏 */
.footer {
  flex-shrink: 0;
  flex-direction: column;
  padding-top: 14rpx;
}

.footer-row {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.foot-btn {
  flex: 1;
  height: 68rpx;
}

.err-text {
  font-size: 21rpx;
  color: #ff7a72;
  margin-bottom: 10rpx;
}
