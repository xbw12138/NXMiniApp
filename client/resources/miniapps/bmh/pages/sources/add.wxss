/* 添加 / 编辑数据源 */
.step {
  font-size: 21rpx;
  color: #6f7883;
}

/* 底部有固定操作栏，滚动区不能撑满整页，否则内容会被压到栏下面 */
.scroll {
  flex: 1;
  height: auto;
}

/* 类型选择：3 个一行，两行 */
.type-grid {
  flex-direction: column;
  margin-bottom: 6rpx;
}

.type-row {
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.type-card {
  width: 470rpx;
  height: 92rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background-color: #171a20;
  border: 2rpx solid #23272f;
  flex-direction: row;
  align-items: center;
}

.type-on {
  background-color: #2a1a1c;
  border: 2rpx solid #4a2a2c;
}

.type-badge {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background-color: #23272f;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.type-badge-on {
  background-color: #ff3b30;
}

.type-badge-text {
  font-size: 24rpx;
  font-weight: bold;
  color: #e8ebf0;
}

.type-meta {
  flex-direction: column;
  overflow: hidden;
}

.type-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #eef1f5;
}

.type-desc {
  font-size: 19rpx;
  color: #78818d;
  margin-top: 4rpx;
}

/* 表单 */
.field {
  flex-direction: row;
  align-items: center;
  margin-bottom: 14rpx;
}

.field-label {
  width: 220rpx;
  font-size: 23rpx;
  color: #9aa1ab;
  flex-shrink: 0;
}

.req {
  font-size: 22rpx;
  color: #ff5c52;
}

.field-input {
  flex: 1;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background-color: #1a1d23;
  color: #eef1f5;
  font-size: 23rpx;
}

/* 测试结果 */
.test-box {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background-color: #191c22;
}

.test-text {
  font-size: 22rpx;
  color: #a9b2bd;
}

.test-ok {
  background-color: #12251a;
}

.test-ok .test-text {
  color: #3ddc84;
}

.test-fail {
  background-color: #2a1717;
}

.test-fail .test-text {
  color: #ff7a72;
}

/* 底部操作栏 */
.footer {
  flex-shrink: 0;
  flex-direction: column;
  padding-top: 14rpx;
}

.footer-row {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.foot-btn {
  flex: 1;
  height: 68rpx;
}

.err-text {
  font-size: 21rpx;
  color: #ff7a72;
  margin-bottom: 10rpx;
}

/* SMB 根目录浏览 */
.browse-row {
  flex-direction: row;
  align-items: center;
  margin: -4rpx 0 14rpx 220rpx;
}

.browse-btn {
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background-color: #262a31;
  border: 1rpx solid #343940;
  align-items: center;
  justify-content: center;
}

.browse-btn-text {
  font-size: 22rpx;
  color: #eef1f5;
}

.hint-inline {
  margin: 0 0 0 14rpx;
}

.dir-panel {
  flex-direction: column;
  margin: 0 0 16rpx 220rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background-color: #14171c;
  border: 1rpx solid #22262d;
}

.dir-head {
  flex-direction: row;
  align-items: center;
  margin-bottom: 8rpx;
}

.dir-path {
  flex: 1;
  font-size: 21rpx;
  color: #8b949e;
}

.dir-close {
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background-color: #1c2027;
  align-items: center;
  justify-content: center;
}

.dir-close-text {
  font-size: 20rpx;
  color: #c3cad4;
}

.dir-row {
  flex-direction: row;
  align-items: center;
  height: 60rpx;
  padding: 0 14rpx;
  margin-bottom: 6rpx;
  border-radius: 10rpx;
  background-color: #191c22;
}

.dir-name {
  flex: 1;
  font-size: 22rpx;
  color: #eef1f5;
}

.dir-enter {
  font-size: 20rpx;
  color: #7d8693;
}

.dir-empty {
  padding: 14rpx 10rpx;
}

.dir-empty-text {
  font-size: 21rpx;
  color: #6f7883;
}

.dir-use {
  height: 56rpx;
  margin-top: 8rpx;
  border-radius: 28rpx;
  background-color: #ff3b30;
  align-items: center;
  justify-content: center;
}

.dir-use-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 阿里云盘 / 百度网盘 扫码登录 */
.login-box {
  flex-direction: column;
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background-color: #14171c;
  border: 1rpx solid #22262d;
}

.login-meta {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}

.login-title {
  flex: 1;
  font-size: 23rpx;
  color: #eef1f5;
}

.login-ok {
  font-size: 21rpx;
  color: #4cd964;
}

.login-tip {
  font-size: 21rpx;
  color: #8b949e;
}

.login-actions {
  flex-direction: row;
  align-items: center;
}

.qr-panel {
  flex-direction: column;
  margin-bottom: 16rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background-color: #101318;
  border: 1rpx solid #22262d;
}

.qr-head {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
}

.qr-title {
  flex: 1;
  font-size: 22rpx;
  color: #c3cad4;
}

.qr-area {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 12rpx 0;
}

.qr-box {
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  border-radius: 10rpx;
  background-color: #ffffff;
}

.qr-row {
  flex-direction: row;
}

.qr-black {
  background-color: #111111;
}

.qr-placeholder {
  width: 300rpx;
  height: 300rpx;
  flex-direction: column;
  background-color: #191c22;
}

.qr-tip {
  font-size: 22rpx;
  color: #c3cad4;
  text-align: center;
}

.qr-tip-err {
  color: #ff7a72;
  margin-bottom: 12rpx;
}

.qr-tip-ok {
  color: #4cd964;
}

.qr-refresh {
  height: 52rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background-color: #262a31;
  border: 1rpx solid #343940;
  align-items: center;
  justify-content: center;
}

.qr-refresh-text {
  font-size: 22rpx;
  color: #eef1f5;
}

.qr-status {
  font-size: 21rpx;
  color: #8b949e;
  margin: 4rpx 0 6rpx 0;
}
