<view class="page">
  <view class="topbar">
    <text class="brand">数据源</text>
    <view class="spacer"/>
    <button class="btn add-btn" bindtap="onAdd">+ 添加数据源</button>
  </view>

  <scroll-view class="scroll" scroll-y="{{true}}" style="height: 100%;">
    <block wx:if="{{sources.length === 0}}">
      <view class="empty-big">
        <text class="empty-title">还没有数据源</text>
        <text class="empty-sub">添加后可自动刮削海报、评分与简介</text>
        <button class="btn empty-btn" bindtap="onAdd">添加第一个数据源</button>
      </view>
    </block>

    <view wx:for="{{sources}}" wx:key="id" class="src-card">
      <view class="src-head">
        <view class="src-tag src-tag-{{item.type}}">
          <text class="src-tag-text">{{item.badge}}</text>
        </view>
        <view class="src-info">
          <text class="src-name">{{item.name}}</text>
          <text class="src-addr">{{item.addr}}</text>
        </view>
        <view class="src-state">
          <view class="dot {{item.enabled ? 'dot-on' : 'dot-off'}}"></view>
          <text class="src-state-text {{item.enabled ? 'src-on' : 'src-off'}}">{{item.enabled ? '已启用' : '已禁用'}}</text>
        </view>
      </view>

      <view class="src-foot">
        <text class="src-count">{{item.countText}}</text>
        <view class="spacer"/>
        <view class="link" data-id="{{item.id}}" bindtap="onToggle">
          <text class="link-text">{{item.enabled ? '禁用' : '启用'}}</text>
        </view>
        <view class="link" data-id="{{item.id}}" bindtap="onTest">
          <text class="link-text">测试</text>
        </view>
        <view class="link" data-id="{{item.id}}" bindtap="onEdit">
          <text class="link-text">编辑</text>
        </view>
        <view class="link" data-id="{{item.id}}" bindtap="onDelete">
          <text class="link-text link-del">删除</text>
        </view>
      </view>

      <text wx:if="{{item.testText}}" class="src-test {{item.testOk ? 'src-test-ok' : 'src-test-fail'}}">{{item.testText}}</text>
    </view>

    <view class="card help">
      <text class="card-title">支持的协议</text>
      <text class="help-line">Emby / Jellyfin：自带刮削，海报、评分、简介完整</text>
      <text class="help-line">WebDAV：群晖、极空间、飞牛等 NAS 通用</text>
      <text class="help-line">SMB：Windows 共享与局域网 NAS，按文件名匹配海报</text>
      <text class="help-line">阿里云盘 / 百度网盘：填 token 后直接浏览</text>
    </view>
  </scroll-view>
</view>
