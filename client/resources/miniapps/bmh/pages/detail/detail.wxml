<view class="page" wx:if="{{movie}}">
  <scroll-view class="body" scroll-y="{{true}}" style="height: 100%;">
    <!-- 顶部大图 + 信息 -->
    <view class="hero">
      <image wx:if="{{movie.poster}}" class="hero-bg" src="{{movie.poster}}" mode="aspectFill"/>
      <view wx:else class="hero-bg hero-bg-empty"></view>
      <view wx:if="{{movie.poster}}" class="hero-shade"></view>
      <view class="hero-info">
        <text class="hero-type">{{typeLabel}}</text>
        <view class="hero-title-box">
          <text class="hero-title">{{movie.title}}</text>
        </view>
        <view class="meta-row">
          <text wx:if="{{movie.rating}}" class="meta-rating">{{movie.rating}} 分</text>
          <text wx:if="{{movie.year}}" class="meta-chip">{{movie.year}}</text>
          <text wx:if="{{movie.genre}}" class="meta-chip">{{movie.genre}}</text>
          <text wx:if="{{movie.duration}}" class="meta-chip">{{movie.duration}}</text>
          <text wx:if="{{movie.region}}" class="meta-chip">{{movie.region}}</text>
        </view>
        <text wx:if="{{progressText}}" class="hero-progress">{{progressText}}</text>
        <view class="action-row">
          <button class="btn btn-play" bindtap="onPlay">{{progressText ? '继续播放' : '立即播放'}}</button>
          <button class="btn btn-ghost" bindtap="onToggleFav">{{isFav ? '已收藏' : '收藏'}}</button>
        </view>
      </view>
    </view>

    <!-- 简介 -->
    <view class="block">
      <view class="block-head">
        <view class="block-bar"></view>
        <text class="block-title">简介</text>
      </view>
      <text class="summary">{{movie.summary || '暂无简介'}}</text>
    </view>

    <!-- 演职员 -->
    <view wx:if="{{movie.director || movie.actors}}" class="block">
      <view class="block-head">
        <view class="block-bar"></view>
        <text class="block-title">演职员</text>
      </view>
      <text wx:if="{{movie.director}}" class="line">导演：{{movie.director}}</text>
      <text wx:if="{{movie.actors}}" class="line">主演：{{movie.actors}}</text>
    </view>

    <!-- 同类推荐 -->
    <view wx:if="{{similar.length > 0}}" class="block">
      <view class="block-head">
        <view class="block-bar"></view>
        <text class="block-title">同类推荐</text>
      </view>
      <view class="grid">
        <view class="poster-row" wx:for="{{similarRows}}" wx:for-item="row" wx:key="index">
          <view wx:for="{{row}}" wx:for-item="item" wx:key="id"
                class="poster-card" data-id="{{item.id}}" bindtap="onSimilar">
            <view class="poster-box">
              <image wx:if="{{item.poster}}" class="poster" src="{{item.poster}}" mode="aspectFill"/>
              <view wx:else class="poster poster-empty">
                <text class="poster-empty-text">{{item.title}}</text>
              </view>
            </view>
            <view class="poster-title-box">
              <text class="poster-title">{{item.title}}</text>
            </view>
            <text class="poster-sub">{{item.year}}{{item.rating ? ' · ' + item.rating + '分' : ''}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<view wx:else class="page">
  <!-- 加载中页面也要有可聚焦节点，否则整页没有焦点项，摇杆完全没反应 -->
  <view class="loading-card">
    <text class="loading-title">正在加载影片信息…</text>
    <text class="hint">网络慢时可能需要几秒</text>
    <view class="loading-back" bindtap="onBack">
      <text class="loading-back-text">返回上一页</text>
    </view>
  </view>
</view>
