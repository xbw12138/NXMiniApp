<view class="page" wx:if="{{movie}}">
  <scroll-view class="scroll" scroll-y="{{true}}" style="height: 100%;">
    <!-- 头部：海报 + 基本信息 -->
    <view class="head">
      <image class="head-poster" src="{{movie.poster}}" mode="aspectFill"/>
      <view class="head-info">
        <text class="head-title">{{movie.title}}</text>
        <view class="head-rating-row">
          <text class="head-rating">{{movie.rating}}</text>
          <text class="head-rating-star">★</text>
          <text class="head-type-tag">{{typeLabel}}</text>
        </view>
        <text class="head-line">{{movie.year}} · {{movie.genre}}</text>
        <text class="head-line">{{movie.duration}} · {{movie.region}}</text>
        <text class="head-line">导演：{{movie.director}}</text>
        <text class="head-line">主演：{{movie.actors}}</text>
        <text wx:if="{{progressText}}" class="head-progress">{{progressText}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="row action-row">
      <button class="btn btn-play" bindtap="onPlay">▶ 立即播放</button>
      <button class="btn btn-ghost btn-fav" bindtap="onToggleFav">
        {{isFav ? '♥ 已收藏' : '♡ 收藏'}}
      </button>
    </view>

    <!-- 简介 -->
    <view class="card">
      <text class="section-title">剧情简介</text>
      <text class="summary">{{movie.summary}}</text>
    </view>

    <!-- 选集（电视剧 / 动漫 / 综艺） -->
    <view wx:if="{{episodes.length > 0}}" class="card">
      <text class="section-title">选集</text>
      <view class="ep-grid">
        <view wx:for="{{episodes}}" wx:key="index"
              class="ep-btn {{currentEp === item.index ? 'ep-on' : ''}}"
              data-index="{{item.index}}" bindtap="onPickEp">
          <text class="ep-text">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 同类推荐 -->
    <view wx:if="{{similar.length > 0}}">
      <text class="section-title">同类推荐</text>
      <view class="grid">
        <view wx:for="{{similar}}" wx:key="id"
              class="poster-card" data-id="{{item.id}}" bindtap="onSimilar">
          <image class="poster" src="{{item.poster}}" mode="aspectFill"/>
          <view class="poster-meta">
            <text class="poster-title">{{item.title}}</text>
            <text class="poster-sub">{{item.year}} · {{item.rating}}分</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
