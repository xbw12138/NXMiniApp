/* 详情页 · 大图头部 + 信息块 */
.body {
  flex: 1;
}

.hero {
  height: 420rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #12151a;
  border: 1rpx solid #22262d;
  margin-bottom: 10rpx;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-bg-empty {
  background-color: #171b21;
}

.hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(6, 8, 11, 0.74);
}

.hero-info {
  flex-direction: column;
  padding: 40rpx 48rpx;
}

.hero-type {
  font-size: 22rpx;
  font-weight: bold;
  color: #ff6a5c;
}

.hero-title-box {
  height: 64rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.hero-title {
  font-size: 50rpx;
  font-weight: bold;
  line-height: 60rpx;
  color: #ffffff;
}

.meta-row {
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
}

.meta-rating {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffb800;
  margin-right: 14rpx;
}

.meta-chip {
  height: 38rpx;
  padding: 0 14rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  background-color: rgba(255, 255, 255, 0.1);
  font-size: 21rpx;
  color: #dfe5ec;
  text-align: center;
}

.hero-progress {
  font-size: 22rpx;
  color: #0fdc78;
  margin-top: 12rpx;
}

.action-row {
  flex-direction: row;
  margin-top: 28rpx;
}

.btn-play {
  width: 260rpx;
  margin-right: 16rpx;
}

.btn-ghost {
  width: 200rpx;
}

/* 信息块 */
.block {
  flex-direction: column;
  margin-top: 30rpx;
}

.block-head {
  flex-direction: row;
  align-items: center;
  margin: 0 4rpx 14rpx;
}

.block-bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background-color: #ff3b30;
  margin-right: 12rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  margin: 0;
}

.summary {
  font-size: 24rpx;
  line-height: 40rpx;
  color: #b6bec9;
  margin: 0 4rpx;
}

.line {
  font-size: 23rpx;
  color: #9aa3af;
  margin: 0 4rpx 6rpx;
}

/* 同类推荐 */
.grid {
  flex-direction: column;
}

.poster-row {
  flex-direction: row;
}

.poster-card {
  width: 270rpx;
  margin: 0 14rpx 26rpx 0;
  flex-direction: column;
}

.poster-box {
  width: 270rpx;
  height: 396rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: #171b21;
}

.poster {
  width: 270rpx;
  height: 396rpx;
}

.poster-empty {
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.poster-empty-text {
  font-size: 22rpx;
  color: #5d6672;
  text-align: center;
}

.poster-title-box {
  height: 32rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.poster-title {
  font-size: 23rpx;
  font-weight: bold;
  color: #e9edf2;
}

.poster-sub {
  font-size: 19rpx;
  color: #6f7883;
  margin-top: 2rpx;
}

/* 加载态：保留可聚焦的返回入口 */
.loading-card {
  flex-direction: column;
  align-items: flex-start;
  padding: 48rpx 44rpx;
  border-radius: 20rpx;
  background-color: #14171c;
  border: 1rpx solid #22262d;
  margin-top: 40rpx;
}

.loading-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #eef1f5;
}

.loading-back {
  height: 60rpx;
  padding: 0 34rpx;
  margin-top: 34rpx;
  border-radius: 30rpx;
  background-color: #ff3b30;
  align-items: center;
  justify-content: center;
}

.loading-back-text {
  font-size: 23rpx;
  font-weight: bold;
  color: #ffffff;
}
