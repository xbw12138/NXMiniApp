<view class="play-page">
  <video wx:if="{{videoSrc}}" id="player" class="player" src="{{videoSrc}}"
         http-headers="{{headers}}"
         controls="{{true}}" autoplay="{{true}}"
         object-fit="contain"
         bindplay="onPlay" bindpause="onPause" bindended="onEnded"
         bindtimeupdate="onTime" binderror="onError"/>

  <view wx:if="{{videoSrc}}" class="hud">
    <text class="hud-title">{{title}}</text>
    <text class="hud-time">{{timeText}}</text>
  </view>

  <view wx:else class="loading-box">
    <text class="loading-text">{{statusText || '正在获取播放地址…'}}</text>
    <button wx:if="{{!loading}}" class="btn retry-btn" bindtap="onBack">返回</button>
  </view>
</view>
