<view class="play-page">
  <video wx:if="{{videoSrc}}" id="player" class="player" src="{{videoSrc}}"
         http-headers="{{headers}}"
         controls="{{true}}" autoplay="{{true}}"
         object-fit="contain"
         bindplay="onPlay" bindpause="onPause" bindended="onEnded"
         bindloadedmetadata="onMeta"
         bindtimeupdate="onTime" binderror="onError"/>

  <view wx:elif="{{loading}}" class="state-box">
    <view class="state-card">
      <text class="state-title">正在准备播放…</text>
      <text class="state-sub">{{statusText || '正在获取播放地址'}}</text>
    </view>
  </view>

  <view wx:else class="state-box">
    <view class="state-card">
      <text class="state-title error">无法播放此视频</text>
      <text class="state-sub">{{statusText}}</text>
      <text class="state-hint">常见原因：HEVC 10bit / AV1 等编码不受支持，或网络、SMB 数据源断开。</text>
      <view class="actions">
        <view class="btn primary" bindtap="onRetry">重试</view>
        <view class="btn" bindtap="onBack">返回列表</view>
      </view>
    </view>
  </view>
</view>
