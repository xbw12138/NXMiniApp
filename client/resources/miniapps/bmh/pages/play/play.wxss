/* 播放页 */
.play-page {
  padding: 0;
}

.player {
  width: 100%;
  height: 520rpx;
  background-color: #000000;
  flex-shrink: 0;
}

.player-loading {
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 26rpx;
  color: #8b949e;
}

.panel {
  flex: 1;
  padding: 20rpx 24rpx;
  flex-direction: column;
}

.pname {
  font-size: 30rpx;
  font-weight: bold;
  color: #e6e9ee;
  margin-bottom: 10rpx;
}

.info-row {
  margin-top: 10rpx;
}

.time-text {
  font-size: 24rpx;
  color: #0fdc78;
  font-weight: bold;
  margin-right: 16rpx;
}

.ctrl-row {
  margin-top: 20rpx;
}

.ctrl-row .btn {
  flex: 1;
  margin-right: 14rpx;
}
