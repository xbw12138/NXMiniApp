/* 播放页 · 全屏沉浸，进度/时间/按键提示由容器原生控制层绘制 */
.play-page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.player {
  width: 100%;
  height: 100%;
}

.state-box {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.state-card {
  width: 76%;
  flex-direction: column;
  align-items: center;
  padding: 44rpx 40rpx;
  border-radius: 20rpx;
  background-color: #17191d;
}

.state-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #f2f4f7;
}

.state-title.error {
  color: #ff6b6b;
}

.state-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #aab2bd;
  text-align: center;
}

.state-hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 32rpx;
  color: #6f7681;
  text-align: center;
}

.actions {
  margin-top: 32rpx;
  flex-direction: row;
}

.btn {
  padding: 16rpx 44rpx;
  margin: 0 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #e6e9ee;
  background-color: #2a2e35;
}

.btn.primary {
  color: #0b0d10;
  background-color: #0fdc78;
}
