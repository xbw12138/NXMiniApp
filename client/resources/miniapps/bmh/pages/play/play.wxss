/* 播放页 · 全屏沉浸 */
.play-page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.player {
  width: 100%;
  height: 100%;
}

.hud {
  position: absolute;
  left: 28rpx;
  top: 20rpx;
  flex-direction: column;
}

.hud-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
}

.hud-time {
  font-size: 20rpx;
  color: #aab2bd;
  margin-top: 2rpx;
}

.loading-box {
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.loading-text {
  font-size: 24rpx;
  color: #9aa3af;
}

.retry-btn {
  margin-top: 26rpx;
  padding: 0 40rpx;
}
