<view class="page">
  <view class="searchbar">
    <view wx:if="{{mode === 'search'}}" class="input-box">
      <input class="input" value="{{keyword}}" placeholder="搜索片名 / 演员"
             bindinput="onInput" bindconfirm="onConfirm"/>
      <view class="go-btn" bindtap="onSearch">
        <text class="go-text">{{loading ? '搜索中' : '搜索'}}</text>
      </view>
    </view>
    <view wx:else class="fav-head">
      <text class="fav-title">{{title}}</text>
      <text class="fav-count">{{results.length}} 部</text>
    </view>
  </view>

  <scroll-view class="body" scroll-y="{{true}}" style="height: 100%;">
    <view wx:if="{{sourceCount === 0 && mode === 'search'}}" class="empty">
      <text class="empty-text">请先添加数据源</text>
    </view>

    <view wx:if="{{results.length === 0 && !loading}}" class="empty">
      <text class="empty-text">{{mode === 'fav' ? '还没有收藏任何影片' : (keyword ? '未找到匹配的影片' : '输入关键词开始搜索')}}</text>
    </view>

    <view class="grid">
      <view class="poster-row" wx:for="{{resultRows}}" wx:for-item="row" wx:key="index">
        <view class="poster-card" wx:for="{{row}}" wx:key="id" data-id="{{item.id}}" bindtap="onItem">
          <view class="poster-box">
            <image wx:if="{{item.poster}}" class="poster" src="{{item.poster}}" mode="aspectFill"/>
            <view wx:else class="poster poster-empty">
              <text class="poster-empty-text">{{item.title}}</text>
            </view>
            <view wx:if="{{item.rating}}" class="rating-badge">
              <text class="rating-text">{{item.rating}}</text>
            </view>
          </view>
          <view class="poster-title-box">
            <text class="poster-title">{{item.title}}</text>
          </view>
          <text class="poster-sub">{{item.meta}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
