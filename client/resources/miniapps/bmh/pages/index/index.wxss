/* 首页 · TV 版：大图推荐 + 继续观看 + 数据源筛选 + 五列海报墙 */
.logo {
  flex-direction: row;
  align-items: center;
}

.logo-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background-color: #ff3b30;
  margin-right: 10rpx;
}

.logo-text {
  font-size: 38rpx;
  font-weight: bold;
  color: #ffffff;
}

.logo-sub {
  font-size: 20rpx;
  color: #6f7883;
  margin-left: 14rpx;
}

.nav-btn {
  height: 56rpx;
  padding: 0 24rpx;
  margin-left: 12rpx;
  border-radius: 28rpx;
  background-color: #191c22;
  border: 1rpx solid #22262d;
  align-items: center;
  justify-content: center;
}

.nav-btn-accent {
  background-color: #23262c;
  border: 1rpx solid #343940;
}

.nav-text {
  font-size: 22rpx;
  color: #c3cad4;
}

.body {
  flex: 1;
}

/* 顶部大图 */
.hero {
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  background-color: #12151a;
}

.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hero-bg-empty {
  background-color: #171b21;
}

.hero-shade {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(6, 8, 11, 0.72);
}

.hero-info {
  flex-direction: column;
  padding: 34rpx 44rpx;
}

.hero-kicker-row {
  flex-direction: row;
  align-items: center;
}

.hero-kicker-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background-color: #ff3b30;
  margin-right: 10rpx;
}

.hero-kicker {
  font-size: 21rpx;
  font-weight: bold;
  color: #ff6a5c;
}

.hero-title-box {
  height: 62rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: bold;
  line-height: 60rpx;
  color: #ffffff;
}

.hero-meta {
  font-size: 23rpx;
  color: #b9c2cd;
  margin-top: 10rpx;
}

.hero-btn {
  width: 220rpx;
  height: 58rpx;
  margin-top: 24rpx;
  border-radius: 29rpx;
  background-color: #ff3b30;
  align-items: center;
  justify-content: center;
}

.hero-btn-text {
  font-size: 23rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 分区标题：统一左侧竖条 + 标题 + 计数 */
.section {
  margin-bottom: 4rpx;
}

.section-head {
  flex-direction: row;
  align-items: center;
  margin: 6rpx 4rpx 14rpx;
  flex-shrink: 0;
}

.section-bar {
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background-color: #ff3b30;
  margin-right: 12rpx;
}

.section-head .section-title {
  margin: 0;
}

.section-count {
  font-size: 20rpx;
  color: #6f7883;
  margin-left: 10rpx;
}

/* 继续观看横滑 */
.hscroll {
  flex-shrink: 0;
  margin-bottom: 6rpx;
}

.hrow {
  flex-direction: row;
  padding: 2rpx 2rpx 10rpx;
}

.ep-card {
  width: 318rpx;
  margin-right: 16rpx;
  flex-direction: column;
}

.ep-cover {
  width: 318rpx;
  height: 178rpx;
  border-radius: 14rpx;
  background-color: #1c2026;
}

.ep-cover-empty {
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.ep-empty-text {
  font-size: 20rpx;
  color: #5d6672;
  text-align: center;
}

.ep-title-box {
  height: 30rpx;
  overflow: hidden;
  margin-top: 8rpx;
}

.ep-title {
  font-size: 22rpx;
  color: #eef1f5;
}

.ep-sub {
  font-size: 19rpx;
  color: #7d8693;
  margin-top: 2rpx;
}

/* 数据源筛选 */
.filter-scroll {
  flex-shrink: 0;
  margin: 8rpx 0 10rpx;
}

.filters {
  flex-direction: row;
  align-items: center;
  padding: 0 2rpx;
}

.chip {
  height: 52rpx;
  padding: 0 20rpx;
  margin-right: 12rpx;
  border-radius: 26rpx;
  background-color: #171a20;
  border: 1rpx solid #22262d;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.chip-on {
  background-color: #ff3b30;
  border: 1rpx solid #ff3b30;
}

.chip-text {
  font-size: 22rpx;
  color: #c3cad4;
}

.chip-on .chip-text {
  font-weight: bold;
  color: #ffffff;
}

.chip-count {
  font-size: 18rpx;
  color: #6f7883;
  margin-left: 8rpx;
}

.chip-on .chip-count {
  color: #ffd9d4;
}

/* 海报墙 */
.grid {
  flex-direction: column;
}

.poster-row {
  flex-direction: row;
}

.poster-card {
  width: 270rpx;
  margin: 0 14rpx 26rpx 0;
  flex-direction: column;
}

.poster-box {
  width: 270rpx;
  height: 396rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: #171b21;
}

.poster {
  width: 270rpx;
  height: 396rpx;
}

.poster-empty {
  align-items: center;
  justify-content: center;
  padding: 10rpx;
}

.poster-empty-text {
  font-size: 22rpx;
  color: #5d6672;
  text-align: center;
}

.rating-badge {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background-color: rgba(0, 0, 0, 0.72);
  align-items: center;
  justify-content: center;
}

.rating-text {
  font-size: 20rpx;
  font-weight: bold;
  color: #ffb800;
}

.poster-title-box {
  height: 32rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.poster-title {
  font-size: 23rpx;
  font-weight: bold;
  color: #e9edf2;
}

.poster-sub {
  font-size: 19rpx;
  color: #6f7883;
  margin-top: 2rpx;
}

/* 无数据源引导 */
.empty-big {
  padding: 90rpx 40rpx;
  align-items: center;
  flex-direction: column;
}

.empty-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #e6e9ee;
  margin-bottom: 16rpx;
}

.add-btn {
  margin-top: 30rpx;
  padding: 0 60rpx;
}
