<view class="page">
  <view class="topbar">
    <view class="logo">
      <view class="logo-dot"></view>
      <text class="logo-text">爆米花</text>
      <text wx:if="{{sourceCount > 0}}" class="logo-sub">{{sourceCount}} 个数据源</text>
    </view>
    <view class="spacer"></view>
    <view class="nav-btn" bindtap="onSearch">
      <text class="nav-text">搜索</text>
    </view>
    <view class="nav-btn" bindtap="onFavEntry">
      <text class="nav-text">收藏 {{favCount}}</text>
    </view>
    <view class="nav-btn nav-btn-accent" bindtap="onSources">
      <text class="nav-text">数据源 {{sourceCount}}</text>
    </view>
  </view>

  <scroll-view class="body" scroll-y="{{true}}" style="height: 100%;">
    <!-- 无数据源引导 -->
    <view wx:if="{{sourceCount === 0}}" class="empty-big">
      <text class="empty-title">还没有添加数据源</text>
      <text class="hint">接入你的影视库后即可在这里看到全部影片</text>
      <text class="hint">支持 Emby / Jellyfin / WebDAV / SMB / 阿里云盘 / 百度网盘</text>
      <button class="btn add-btn" bindtap="onSources">去添加数据源</button>
    </view>

    <block wx:else>
      <!-- 顶部大图：优先最近观看 -->
      <view wx:if="{{hero && !hideRecent}}" class="hero" data-id="{{hero.id}}" bindtap="onHeroTap">
        <image wx:if="{{hero.poster}}" class="hero-bg" src="{{hero.poster}}" mode="aspectFill"/>
        <view wx:else class="hero-bg hero-bg-empty"></view>
        <view class="hero-shade"></view>
        <view class="hero-info">
          <view class="hero-kicker-row">
            <view class="hero-kicker-dot"></view>
            <text class="hero-kicker">{{hero.kicker}}</text>
          </view>
          <view class="hero-title-box">
            <text class="hero-title">{{hero.title}}</text>
          </view>
          <text class="hero-meta">{{hero.meta}}</text>
          <view class="hero-btn">
            <text class="hero-btn-text">{{hero.action}}</text>
          </view>
        </view>
      </view>

      <!-- 继续观看 -->
      <view wx:if="{{recent.length > 1 && !hideRecent}}" class="section">
        <view class="section-head">
          <view class="section-bar"></view>
          <text class="section-title">继续观看</text>
          <text class="section-count">{{recent.length}} 部</text>
        </view>
        <scroll-view class="hscroll" scroll-x="{{true}}" style="height: 248rpx;">
          <view class="hrow">
            <view class="ep-card" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}"
                  bindtap="onRecent">
              <image wx:if="{{item.poster}}" class="ep-cover" src="{{item.poster}}" mode="aspectFill"/>
              <view wx:else class="ep-cover ep-cover-empty">
                <text class="ep-empty-text">{{item.title}}</text>
              </view>
              <view class="ep-title-box">
                <text class="ep-title">{{item.title}}</text>
              </view>
              <text class="ep-sub">{{item.progressText}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 数据源筛选：源多时横向滚动，不会挤出屏幕 -->
      <scroll-view class="filter-scroll" scroll-x="{{true}}" style="height: 76rpx;">
        <view class="filters">
          <view class="chip {{activeSource === item.id ? 'chip-on' : ''}}" wx:for="{{chips}}" wx:key="id"
                data-source="{{item.id}}" bindtap="onFilter">
            <text class="chip-text">{{item.label}}</text>
            <text wx:if="{{item.count >= 0}}" class="chip-count">{{item.count}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{loading}}" class="empty">
        <text class="empty-text">正在加载影片…</text>
      </view>

      <!-- SMB 目录浏览：没有刮削信息，按目录 + 文件的形式展示 -->
      <block wx:for="{{browsers}}" wx:key="sourceId" wx:for-item="b">
        <view wx:if="{{activeSource === '' || activeSource === b.sourceId}}" class="browser">
          <view class="section-head">
            <view class="section-bar"></view>
            <text class="section-title">{{b.sourceName}}</text>
            <text wx:if="{{b.videoCount > 0}}" class="section-count">{{b.videoCount}} 个视频</text>
          </view>

          <view class="crumb-row">
            <view class="crumb" wx:for="{{b.crumbs}}" wx:for-item="c" wx:for-index="ci" wx:key="path"
                  data-source="{{b.sourceId}}" data-path="{{c.path}}" bindtap="onCrumb">
              <text class="crumb-text {{ci === b.crumbs.length - 1 ? 'crumb-last' : ''}}">{{c.label}}</text>
              <text wx:if="{{ci < b.crumbs.length - 1}}" class="crumb-sep">/</text>
            </view>
            <view wx:if="{{b.path !== b.rootPath}}" class="crumb-back"
                  data-source="{{b.sourceId}}" bindtap="onBrowserUp">
              <text class="crumb-back-text">返回上级</text>
            </view>
          </view>

          <view wx:if="{{b.loading}}" class="empty">
            <text class="empty-text">正在读取目录…</text>
          </view>
          <view wx:elif="{{b.error}}" class="empty">
            <text class="error">读取目录失败：{{b.error}}</text>
          </view>
          <view wx:elif="{{b.items.length === 0}}" class="empty">
            <text class="empty-text">该目录下没有视频文件</text>
          </view>
          <view wx:else class="file-list">
            <view class="file-row" wx:for="{{b.items}}" wx:key="path"
                  data-source="{{b.sourceId}}" data-path="{{item.path}}"
                  data-kind="{{item.kind}}" data-label="{{item.label}}" bindtap="onBrowserItem">
              <view class="file-icon {{item.kind === 'dir' ? 'file-icon-dir' : 'file-icon-video'}}">
                <text class="file-icon-text">{{item.kind === 'dir' ? '目录' : '视频'}}</text>
              </view>
              <view class="file-main">
                <view class="file-name-box">
                  <text class="file-name">{{item.label}}</text>
                </view>
                <text class="file-sub">{{item.sub}}</text>
              </view>
              <text class="file-action">{{item.kind === 'dir' ? '进入' : '播放'}}</text>
            </view>
            <text wx:if="{{b.truncated}}" class="hint">条目过多，仅显示前 120 项</text>
          </view>
        </view>
      </block>

      <!-- 海报墙 -->
      <block wx:for="{{groups}}" wx:key="sourceId" wx:for-item="g">
        <view wx:if="{{activeSource === ''}}" class="section-head">
          <view class="section-bar"></view>
          <text class="section-title">{{g.sourceName}}</text>
          <text class="section-count">{{g.total}} 部</text>
        </view>
        <view class="grid">
          <view class="poster-row" wx:for="{{g.rows}}" wx:for-item="row" wx:key="index">
            <view class="poster-card" wx:for="{{row}}" wx:for-item="m" wx:key="id"
                  data-id="{{m.id}}" bindtap="onItem">
              <view class="poster-box">
                <image wx:if="{{m.poster}}" class="poster" src="{{m.poster}}" mode="aspectFill"/>
                <view wx:else class="poster poster-empty">
                  <text class="poster-empty-text">{{m.title}}</text>
                </view>
                <view wx:if="{{m.ratingText}}" class="rating-badge">
                  <text class="rating-text">{{m.ratingText}}</text>
                </view>
              </view>
              <view class="poster-title-box">
                <text class="poster-title">{{m.title}}</text>
              </view>
              <text wx:if="{{m.metaLine}}" class="poster-sub">{{m.metaLine}}</text>
            </view>
          </view>
        </view>
        <button wx:if="{{g.hasMore}}" class="btn more-btn" data-source="{{g.sourceId}}" bindtap="onMore">
          加载更多（{{g.shown}} / {{g.total}}）
        </button>
      </block>

      <!-- 空结果 -->
      <view wx:if="{{!loading && groups.length === 0 && browsers.length === 0}}" class="empty">
        <text class="empty-text">{{errMsg || '未找到影片，请检查数据源配置'}}</text>
      </view>
    </block>
  </scroll-view>
</view>
