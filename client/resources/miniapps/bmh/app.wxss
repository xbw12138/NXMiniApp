/* 网易爆米花 · 全局样式（TV 版深色主题） */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #0a0b0e;
  color: #eef1f5;
  padding: 24rpx;
}

.scroll {
  flex: 1;
  height: 100%;
}

.body {
  flex: 1;
}

/* 顶部栏 */
.topbar {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: 18rpx;
}

.brand {
  font-size: 36rpx;
  font-weight: bold;
  color: #f3f5f8;
}

.brand-dot {
  color: #ff3b30;
}

.spacer {
  flex: 1;
}

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #eef1f5;
  margin: 16rpx 4rpx 14rpx;
  flex-shrink: 0;
}

/* 卡片（数据源等列表页使用） */
.card {
  background-color: #14171c;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #e6e9ee;
}

.card-sub {
  font-size: 22rpx;
  color: #8b949e;
  margin-top: 6rpx;
}

/* 按钮 */
.btn {
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  background-color: #ff3b30;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  align-items: center;
  justify-content: center;
}

.btn-ghost {
  background-color: #22262d;
  color: #e8eaee;
}

.more-btn {
  margin: 4rpx 0 24rpx;
  height: 60rpx;
  background-color: #191c22;
  color: #aeb8c4;
  font-size: 22rpx;
  font-weight: normal;
}

.btn-on {
  background-color: #2563eb;
}

/* 通用 */
.row {
  flex-direction: row;
  align-items: center;
}

.hint {
  font-size: 22rpx;
  color: #7f8792;
  margin-top: 10rpx;
}

.empty {
  padding: 40rpx 0;
  align-items: center;
}

.empty-text {
  font-size: 24rpx;
  color: #6b7481;
}

.error {
  font-size: 22rpx;
  color: #ff6b6b;
  margin-top: 12rpx;
}

/* 分类导航（数据源页等） */
.tabs {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.tab {
  padding: 10rpx 26rpx;
  border-radius: 24rpx;
  margin-right: 14rpx;
  background-color: #191c22;
}

.tab-on {
  background-color: #ff3b30;
}

.tab-text {
  font-size: 24rpx;
  color: #cfd5dd;
  font-weight: bold;
}

.tab-on .tab-text {
  color: #ffffff;
}
