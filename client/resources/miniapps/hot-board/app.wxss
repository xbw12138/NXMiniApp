/* 今日热榜 —— 深色大屏看板 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: row;
  background-color: #080a0f;
  color: #e9eff7;
  padding: 24rpx 30rpx;
}

.side {
  width: 300rpx;
  height: 100%;
  flex-direction: column;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background-color: #0c1119;
  border: 2rpx solid #161f2b;
}

.brand-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #f4f8ff;
}

.brand-sub {
  font-size: 18rpx;
  color: #68788d;
  margin-top: 8rpx;
}

.clock {
  font-size: 62rpx;
  font-weight: bold;
  color: #38bdf8;
  margin-top: 22rpx;
  line-height: 1;
}

.date {
  font-size: 20rpx;
  color: #77879c;
  margin-top: 8rpx;
  margin-bottom: 18rpx;
}

.modes {
  flex-direction: row;
  margin-bottom: 12rpx;
}

.mode {
  flex: 1;
  height: 64rpx;
  margin: 0 4rpx;
  border-radius: 12rpx;
  background-color: #111a25;
  border: 2rpx solid #1e2a3a;
  color: #a9bacd;
  font-size: 23rpx;
  padding: 0;
  line-height: 60rpx;
  text-align: center;
}

.mode-on {
  background-color: #0b3550;
  border-color: #38bdf8;
  color: #e0f2fe;
  font-weight: bold;
}

.sources {
  flex-direction: column;
}

.source {
  height: 58rpx;
  margin-bottom: 8rpx;
  border-radius: 10rpx;
  background-color: #111a25;
  border: 2rpx solid #1e2a3a;
  color: #a9bacd;
  font-size: 22rpx;
  padding: 0 18rpx;
  line-height: 54rpx;
  text-align: left;
}

.source-on {
  background-color: #16283a;
  border-color: #2b6f9e;
  color: #dbeafe;
}

.custom {
  flex-direction: column;
}

.code-input {
  height: 64rpx;
  border-radius: 10rpx;
  background-color: #111a25;
  border: 2rpx solid #1e2a3a;
  color: #e8eef7;
  font-size: 22rpx;
  padding: 0 16rpx;
  margin-bottom: 10rpx;
}

.tip {
  font-size: 18rpx;
  color: #5c6b7e;
  line-height: 1.5;
  margin-top: 6rpx;
}

.spacer {
  flex: 1;
}

.status {
  font-size: 18rpx;
  color: #5c6b7e;
}

.content {
  flex: 1;
  height: 100%;
  margin-left: 22rpx;
  flex-direction: column;
}

.content-head {
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  height: 62rpx;
  flex-shrink: 0;
}

.head-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #f4f8ff;
}

.head-sub {
  font-size: 19rpx;
  color: #5c6b7e;
}

.list {
  flex: 1;
  flex-direction: column;
  margin-top: 12rpx;
}

.row {
  flex-direction: row;
  align-items: center;
  height: 60rpx;
  padding: 0 14rpx;
  margin-bottom: 6rpx;
  border-radius: 10rpx;
  background-color: #0c1119;
  border: 2rpx solid #141c26;
}

.rank {
  width: 42rpx;
  font-size: 24rpx;
  font-weight: bold;
  color: #4f5d70;
  text-align: center;
}

.rank-hot {
  color: #fbbf24;
}

.row-title {
  flex: 1;
  font-size: 25rpx;
  color: #dbe6f3;
  margin-left: 14rpx;
}

.row-value {
  width: 190rpx;
  font-size: 23rpx;
  color: #93a3b8;
  text-align: right;
}

.up {
  color: #f87171;
}

.down {
  color: #34d399;
}

.pager {
  flex-direction: row;
  align-items: center;
  height: 62rpx;
  flex-shrink: 0;
}

.pbtn {
  height: 52rpx;
  margin-right: 12rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background-color: #111a25;
  border: 2rpx solid #1e2a3a;
  color: #a9bacd;
  font-size: 20rpx;
  line-height: 48rpx;
  text-align: center;
}

.pbtn-on {
  background-color: #0b3550;
  border-color: #38bdf8;
  color: #e0f2fe;
}

.page-info {
  font-size: 20rpx;
  color: #68788d;
  margin-right: 12rpx;
}
