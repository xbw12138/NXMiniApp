/* 中国象棋 —— 木纹棋盘主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #14100c;
  padding: 10rpx 16rpx;
  color: #f0e6d6;
}

.top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 62rpx;
  flex-shrink: 0;
}

.brand {
  flex-direction: row;
  align-items: flex-end;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #f7eeda;
  line-height: 1;
}

.subtitle {
  font-size: 19rpx;
  color: #8a7a63;
  margin-left: 12rpx;
  margin-bottom: 3rpx;
}

.status {
  font-size: 24rpx;
  color: #e8b464;
  font-weight: bold;
}

.body {
  flex-direction: row;
  flex: 1;
  align-items: flex-start;
  margin-top: 8rpx;
}

.board {
  width: 588rpx;
  flex-direction: column;
  background-color: #d9b98a;
  border-radius: 12rpx;
  border: 3rpx solid #8a6437;
  padding: 6rpx;
}

.board-row {
  flex-direction: row;
  height: 64rpx;
}

.river {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 34rpx;
  width: 576rpx;
}

.river-text {
  font-size: 18rpx;
  color: #8a6437;
  margin: 0 24rpx;
}

.cell {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #b08d5c;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background-color: #3f8f5a;
}

.piece {
  width: 54rpx;
  height: 54rpx;
  border-radius: 27rpx;
  align-items: center;
  justify-content: center;
  border-width: 3rpx;
}

.piece-r {
  background-color: #f6e7cc;
  border-color: #b3261e;
  color: #b3261e;
}

.piece-b {
  background-color: #f6e7cc;
  border-color: #1d1a16;
  color: #1d1a16;
}

.piece-text {
  font-size: 30rpx;
  font-weight: bold;
  line-height: 1;
}

.sel {
  background-color: #cbe8c4;
  border-color: #2f7d3f;
}

.last {
  background-color: #f3d7a6;
}

.panel {
  flex: 1;
  margin-left: 14rpx;
  flex-direction: column;
}

.turn {
  height: 96rpx;
  border-radius: 12rpx;
  background-color: #1f1913;
  border: 2rpx solid #33291d;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.turn-label {
  font-size: 18rpx;
  color: #8a7a63;
}

.turn-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #f0d9a8;
  line-height: 1.3;
}

.key {
  width: 100%;
  height: 62rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background-color: #231c15;
  border: 2rpx solid #3a2f21;
  color: #d8c7a8;
  font-size: 21rpx;
  padding: 0;
  line-height: 58rpx;
  text-align: center;
}

.key-on {
  background-color: #2f3f2a;
  border-color: #4f7a41;
  color: #bfe0a8;
  font-weight: bold;
}

.key-main {
  background-color: #8c5a22;
  border-color: #b0742c;
  color: #fff4e2;
  font-weight: bold;
}

.hint {
  flex-direction: column;
  margin-top: 2rpx;
}

.hint-line {
  font-size: 17rpx;
  color: #7a6c58;
  line-height: 1.7;
}

.result {
  margin-top: 6rpx;
  padding: 8rpx;
  border-radius: 10rpx;
  background-color: #2a2116;
  border: 2rpx solid #4a3a25;
  align-items: center;
}

.result-text {
  font-size: 22rpx;
  font-weight: bold;
  color: #f0c274;
}
