<view class="page">
  <view class="top">
    <view class="brand">
      <text class="title">中国象棋</text>
      <text class="subtitle">人机对战 · 内置 AI</text>
    </view>
    <text class="status">{{status}}</text>
  </view>

  <view class="body">
    <view class="board">
      <view wx:for="{{topRows}}" wx:for-item="row" class="board-row">
        <view wx:for="{{row}}" wx:for-item="c" class="cell {{c.cls}}" data-idx="{{c.idx}}" bindtap="onTap">
          <view wx:if="{{c.text}}" class="piece {{c.side === 'r' ? 'piece-r' : 'piece-b'}} {{c.sel ? 'sel' : ''}}">
            <text class="piece-text">{{c.text}}</text>
          </view>
          <view wx:elif="{{c.dot}}" class="dot"></view>
        </view>
      </view>

      <view class="river">
        <text class="river-text">楚 河</text>
        <text class="river-text">汉 界</text>
      </view>

      <view wx:for="{{bottomRows}}" wx:for-item="row" class="board-row">
        <view wx:for="{{row}}" wx:for-item="c" class="cell {{c.cls}}" data-idx="{{c.idx}}" bindtap="onTap">
          <view wx:if="{{c.text}}" class="piece {{c.side === 'r' ? 'piece-r' : 'piece-b'}} {{c.sel ? 'sel' : ''}}">
            <text class="piece-text">{{c.text}}</text>
          </view>
          <view wx:elif="{{c.dot}}" class="dot"></view>
        </view>
      </view>
    </view>

    <view class="panel">
      <view class="turn">
        <text class="turn-label">当前走子</text>
        <text class="turn-value">{{turnText}}</text>
      </view>

      <button class="key {{mode === 'ai' ? 'key-on' : ''}}" bindtap="onModeAi">人机对战</button>
      <button class="key {{mode === 'pvp' ? 'key-on' : ''}}" bindtap="onModePvp">双人对战</button>

      <button class="key {{level === 1 ? 'key-on' : ''}}" bindtap="onLevel1">简单</button>
      <button class="key {{level === 2 ? 'key-on' : ''}}" bindtap="onLevel2">普通</button>
      <button class="key {{level === 3 ? 'key-on' : ''}}" bindtap="onLevel3">困难</button>

      <button class="key" bindtap="onUndo">悔棋</button>
      <button class="key key-main" bindtap="onRestart">重新开局</button>

      <view wx:if="{{result}}" class="result">
        <text class="result-text">{{result}}</text>
      </view>
      <view wx:else class="hint">
        <text class="hint-line">先点自己的棋子</text>
        <text class="hint-line">再点绿点落子</text>
        <text class="hint-line">红方先行</text>
      </view>
    </view>
  </view>
</view>
