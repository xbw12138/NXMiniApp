/* UNO —— 客厅牌桌主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #0b0d12;
  color: #eef2f8;
  padding: 14rpx 26rpx 16rpx 26rpx;
}

.topbar {
  flex-direction: row;
  align-items: center;
  height: 54rpx;
  flex-shrink: 0;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #f4f8ff;
}

.turn {
  font-size: 22rpx;
  color: #9fb0c6;
  margin-left: 18rpx;
}

.spacer {
  flex: 1;
}

.chip {
  font-size: 19rpx;
  color: #93a3b8;
  padding: 4rpx 12rpx;
  margin-left: 10rpx;
  border-radius: 8rpx;
  background-color: #141b26;
  border: 2rpx solid #1f2937;
}

.opponents {
  flex-direction: row;
  flex-shrink: 0;
  margin-top: 10rpx;
}

.opp {
  flex: 1;
  flex-direction: row;
  align-items: center;
  height: 66rpx;
  margin-right: 12rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background-color: #101722;
  border: 2rpx solid #1b2532;
}

.opp-on {
  background-color: #16283a;
  border-color: #38bdf8;
}

.opp-name {
  font-size: 22rpx;
  color: #dbe6f3;
  flex: 1;
}

.opp-count {
  font-size: 24rpx;
  font-weight: bold;
  color: #fbbf24;
}

.table {
  flex: 1;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.pile {
  flex-direction: column;
  align-items: center;
  margin: 0 30rpx;
}

.pile-label {
  font-size: 19rpx;
  color: #6b7a8f;
  margin-top: 10rpx;
}

.big-card {
  width: 170rpx;
  height: 240rpx;
  border-radius: 16rpx;
  border: 6rpx solid #f8fafc;
  align-items: center;
  justify-content: center;
}

.big-label {
  font-size: 84rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1;
}

.big-dark {
  color: #1a1d24;
}

.deck {
  width: 150rpx;
  height: 210rpx;
  border-radius: 16rpx;
  border: 4rpx solid #334155;
  background-color: #141b26;
  align-items: center;
  justify-content: center;
}

.deck-label {
  font-size: 34rpx;
  font-weight: bold;
  color: #64748b;
}

.center-info {
  flex-direction: column;
  align-items: center;
  margin-left: 10rpx;
  width: 320rpx;
}

.color-row {
  flex-direction: row;
  align-items: center;
}

.color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  margin-right: 8rpx;
}

.color-name {
  font-size: 24rpx;
  color: #cbd5e1;
}

.message {
  font-size: 23rpx;
  color: #9fb0c6;
  margin-top: 14rpx;
  text-align: center;
  line-height: 1.4;
}

.hand {
  flex-direction: column;
  flex-shrink: 0;
  min-height: 250rpx;
  justify-content: flex-end;
}

.hand-row {
  flex-direction: row;
  justify-content: center;
  margin-bottom: 8rpx;
}

.card {
  width: 86rpx;
  height: 124rpx;
  border-radius: 10rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.22);
  margin: 0 4rpx;
  align-items: center;
  justify-content: center;
}

.card-on {
  border-color: #ffffff;
}

.card-off {
  opacity: 0.45;
}

.card-label {
  font-size: 38rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1;
}

.card-dark-text {
  color: #1a1d24;
}

.c-r { background-color: #e11d48; }
.c-y { background-color: #facc15; }
.c-g { background-color: #16a34a; }
.c-b { background-color: #2563eb; }
.c-w { background-color: #1f2937; }

.actions {
  flex-direction: row;
  flex-shrink: 0;
  justify-content: center;
  height: 62rpx;
  margin-top: 6rpx;
}

.btn {
  height: 56rpx;
  margin: 0 8rpx;
  padding: 0 24rpx;
  border-radius: 10rpx;
  background-color: #141b26;
  border: 2rpx solid #24303f;
  color: #cfdaea;
  font-size: 21rpx;
  line-height: 52rpx;
  text-align: center;
}

.btn-main {
  background-color: #1d4ed8;
  border-color: #2563eb;
  color: #ffffff;
  font-weight: bold;
}

.btn-warn {
  background-color: #3b1d2a;
  border-color: #7f2b45;
  color: #ffb3c7;
}

/* 覆盖层 */
.mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(6, 9, 14, 0.94);
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.panel {
  flex-direction: column;
  align-items: center;
  padding: 40rpx 60rpx;
  border-radius: 22rpx;
  background-color: #101722;
  border: 2rpx solid #22303f;
}

.panel-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #f4f8ff;
}

.panel-sub {
  font-size: 22rpx;
  color: #7b8ba0;
  margin-top: 12rpx;
  margin-bottom: 18rpx;
  text-align: center;
  line-height: 1.5;
}

.panel-row {
  flex-direction: row;
  margin-top: 6rpx;
}

.color-btn {
  width: 120rpx;
  height: 120rpx;
  margin: 0 10rpx;
  border-radius: 16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.25);
  align-items: center;
  justify-content: center;
}
