/* 全局样式 */
.page {
  background-color: #141518;
  color: #f0f1f3;
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 24rpx;
}

.header {
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
}

.header-row {
  flex-direction: row;
  align-items: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #f2f3f5;
}

.badge {
  margin-left: 20rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 18rpx;
  background-color: #0fdc78;
  color: #07130d;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
}

.body {
  flex: 1;
  flex-direction: row;
  margin-top: 16rpx;
}

.panel {
  flex: 1;
  height: 100%;
  margin-right: 16rpx;
  padding-right: 8rpx;
}

.panel-right {
  margin-right: 0;
  margin-left: 8rpx;
}

.card {
  background-color: #1c1e22;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #9aa1ab;
  margin-bottom: 18rpx;
}

.row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 150rpx;
  font-size: 26rpx;
  color: #d5d9df;
}

.tiny {
  font-size: 24rpx;
  color: #aeb5bf;
  margin-left: 10rpx;
  margin-right: 24rpx;
}

.btn {
  flex: 1;
  height: 64rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background-color: #0fdc78;
  color: #07130d;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
}

.btn-ghost {
  background-color: #2a2d33;
  color: #e8eaee;
}

.hint {
  font-size: 22rpx;
  color: #7f8792;
  margin-top: 12rpx;
}

.progress {
  margin-top: 14rpx;
}

.input {
  height: 68rpx;
  background-color: #25282e;
  border-radius: 12rpx;
  padding: 0 18rpx;
  color: #eef0f3;
  font-size: 24rpx;
}

.area-input {
  height: 150rpx;
  margin-top: 12rpx;
}

.list-item {
  flex-direction: row;
  align-items: center;
  height: 58rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}

.list-even {
  background-color: #23262b;
}

.list-name {
  flex: 1;
  font-size: 24rpx;
  color: #e6e9ee;
}

.list-value {
  font-size: 22rpx;
  color: #0fdc78;
}

.swiper {
  height: 240rpx;
  border-radius: 16rpx;
}

.video {
  height: 200rpx;
  border-radius: 16rpx;
}

.slide {
  height: 100%;
  align-items: center;
  justify-content: center;
  color: #f4f6f8;
  font-size: 34rpx;
  font-weight: bold;
}

.slide-a {
  background-color: #153a2a;
}

.slide-b {
  background-color: #23304a;
}

.slide-c {
  background-color: #3b2539;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 12rpx;
}

.nav {
  height: 72rpx;
  background-color: #202329;
  border-radius: 14rpx;
  padding: 0 24rpx;
  color: #e9ebef;
  font-size: 25rpx;
}
