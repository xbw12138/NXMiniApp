<view class="page">
  <view class="topbar">
    <view class="brand">
      <view class="brand-dot"></view>
      <text class="brand-text">飞牛影视</text>
      <text class="brand-sub">{{serverLabel}}</text>
    </view>
    <view class="spacer"></view>
    <view class="nav-btn" bindtap="goSearch">
      <text class="nav-text">搜索</text>
    </view>
    <view class="nav-btn" bindtap="onRefresh">
      <text class="nav-text">刷新</text>
    </view>
    <view class="nav-btn nav-btn-accent" bindtap="goSettings">
      <text class="nav-text nav-text-accent">{{userName}}</text>
    </view>
  </view>

  <scroll-view class="body" scroll-y="{{true}}" style="height: 100%;">
    <view wx:if="{{errMsg}}" class="card">
      <text class="card-title">加载失败</text>
      <text class="error">{{errMsg}}</text>
      <view class="row" style="margin-top: 20rpx;">
        <button class="btn" bindtap="onRefresh">
          <text class="btn-text">重试</text>
        </button>
        <button class="btn btn-ghost" bindtap="goSettings">
          <text class="btn-text">连接设置</text>
        </button>
      </view>
    </view>

    <block wx:if="{{hero}}">
      <view class="hero" data-kind="{{hero.isResume ? 'resume' : 'item'}}" bindtap="onHeroTap">
        <image wx:if="{{hero.backdrop}}" class="hero-bg" src="{{hero.backdrop}}" mode="aspectFill"/>
        <view wx:else class="hero-bg hero-bg-empty"></view>
        <view class="hero-shade"></view>
        <view class="hero-info">
          <view class="hero-kicker-row">
            <view class="hero-kicker-dot"></view>
            <text class="hero-kicker">{{hero.kicker}}</text>
          </view>
          <view class="hero-title-box">
            <text class="hero-title">{{hero.title}}</text>
          </view>
          <text wx:if="{{hero.subTitle}}" class="hero-sub">{{hero.subTitle}}</text>
          <text class="hero-meta">{{hero.meta}}</text>
          <view wx:if="{{hero.progressPercent > 0}}" class="hero-progress">
            <view class="hero-progress-track">
              <view class="hero-progress-fill" style="width: {{hero.progressPercent}}%;"></view>
            </view>
            <text class="hero-progress-text">{{hero.progressText}}</text>
          </view>
          <view class="hero-btn-row">
            <view class="hero-btn">
              <text class="hero-btn-text">{{hero.action}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{loading && !hero}}" class="loading-card">
      <text class="loading-title">正在读取媒体库…</text>
      <text class="hint">首次进入需要向 NAS 请求海报墙</text>
      <view class="loading-back" bindtap="onRefresh">
        <text class="loading-back-text">重新加载</text>
      </view>
    </view>

    <block wx:if="{{resume.length > 0}}">
      <view class="section-head">
        <view class="section-bar"></view>
        <text class="section-title">继续观看</text>
        <text class="section-count">{{resume.length}} 部</text>
      </view>
      <scroll-view class="hscroll" scroll-x="{{true}}" style="height: 500rpx;">
        <view class="hrow">
          <view class="rail-card" wx:for="{{resume}}" wx:key="id" data-id="{{item.id}}"
                data-position="{{item.positionSeconds}}" data-title="{{item.railTitle}}"
                bindtap="onResumeTap">
            <view class="rail-box">
              <image wx:if="{{item.poster}}" class="rail-img" src="{{item.poster}}" mode="aspectFill"/>
              <view wx:else class="rail-img rail-empty">
                <text class="rail-empty-text">{{item.title}}</text>
              </view>
            </view>
            <view class="rail-title-box">
              <text class="rail-title">{{item.railTitle}}</text>
            </view>
            <text wx:if="{{item.railSub}}" class="rail-sub">{{item.railSub}}</text>
            <view class="progress-track">
              <view class="progress-fill" style="width: {{item.progressPercent}}%;"></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </block>

    <block wx:if="{{libRows.length > 0}}">
      <view class="section-head">
        <view class="section-bar"></view>
        <text class="section-title">我的媒体库</text>
        <text class="section-count">{{libraries.length}} 个</text>
      </view>
      <view class="lib-grid">
        <view class="lib-row" wx:for="{{libRows}}" wx:for-item="row" wx:key="index">
          <view class="lib-card" wx:for="{{row}}" wx:for-item="lib" wx:key="id"
                data-id="{{lib.id}}" data-name="{{lib.name}}" bindtap="onLibraryTap">
            <text class="lib-name">{{lib.name}}</text>
            <text class="lib-sub">{{lib.typeText}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{latest.length > 0}}">
      <view class="section-head">
        <view class="section-bar"></view>
        <text class="section-title">最近添加</text>
        <text class="section-count">{{latest.length}} 部</text>
      </view>
      <view class="grid">
        <view class="poster-row" wx:for="{{latestRows}}" wx:for-item="row" wx:key="index">
          <view class="poster-card" wx:for="{{row}}" wx:for-item="m" wx:key="id"
                data-id="{{m.id}}" bindtap="onItemTap">
            <view class="poster-box">
              <image wx:if="{{m.poster}}" class="poster" src="{{m.poster}}" mode="aspectFill"/>
              <view wx:else class="poster poster-empty">
                <text class="poster-empty-text">{{m.title}}</text>
              </view>
              <view wx:if="{{m.rating}}" class="rating-badge">
                <text class="rating-text">{{m.rating}}</text>
              </view>
            </view>
            <view class="poster-title-box">
              <text class="poster-title">{{m.title}}</text>
            </view>
            <text class="poster-sub">{{m.metaLine}}</text>
          </view>
        </view>
      </view>
    </block>

    <block wx:if="{{favs.length > 0}}">
      <view class="section-head">
        <view class="section-bar"></view>
        <text class="section-title">我的收藏</text>
        <text class="section-count">{{favs.length}} 部</text>
      </view>
      <view class="grid">
        <view class="poster-row" wx:for="{{favRows}}" wx:for-item="row" wx:key="index">
          <view class="poster-card" wx:for="{{row}}" wx:for-item="m" wx:key="id"
                data-id="{{m.id}}" bindtap="onItemTap">
            <view class="poster-box">
              <image wx:if="{{m.poster}}" class="poster" src="{{m.poster}}" mode="aspectFill"/>
              <view wx:else class="poster poster-empty">
                <text class="poster-empty-text">{{m.title}}</text>
              </view>
            </view>
            <view class="poster-title-box">
              <text class="poster-title">{{m.title}}</text>
            </view>
            <text class="poster-sub">{{m.metaLine}}</text>
          </view>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && !errMsg && !hero && latest.length === 0}}" class="empty">
      <text class="empty-text">媒体库里还没有影片，先去飞牛影视中添加媒体库吧</text>
    </view>

    <view style="height: 40rpx;"></view>
  </scroll-view>
</view>
