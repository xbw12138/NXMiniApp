.play-page {
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.player {
  width: 100%;
  height: 100%;
}

.hud {
  position: absolute;
  left: 40rpx;
  top: 30rpx;
  flex-direction: column;
}

.hud-title-box {
  height: 40rpx;
  overflow: hidden;
}

.hud-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffffff;
}

.hud-time {
  font-size: 22rpx;
  color: #c3cad4;
  margin-top: 4rpx;
}

.controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 30rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.ctrl-btn {
  height: 62rpx;
  padding: 0 30rpx;
  margin: 0 10rpx;
  border-radius: 31rpx;
  background-color: rgba(20, 23, 28, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  align-items: center;
  justify-content: center;
}

.ctrl-main {
  background-color: rgba(47, 123, 255, 0.9);
  border: 1rpx solid rgba(47, 123, 255, 0.9);
}

.ctrl-text {
  font-size: 22rpx;
  color: #e8eaee;
}

.ctrl-text-main {
  font-weight: bold;
  color: #ffffff;
}

.loading-box {
  flex: 1;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 0 80rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #c3cad4;
  text-align: center;
}

.loading-actions {
  flex-direction: row;
  align-items: center;
  margin-top: 30rpx;
}
