<view class="page">
  <view class="top">
    <view class="brand">
      <text class="title">俄罗斯方块</text>
      <text class="subtitle">消行 · 加速 · 冲高分</text>
    </view>
    <view class="scores">
      <view class="score">
        <text class="score-label">得分</text>
        <text class="score-value">{{score}}</text>
      </view>
      <view class="score">
        <text class="score-label">最高</text>
        <text class="score-value">{{best}}</text>
      </view>
      <view class="score">
        <text class="score-label">等级</text>
        <text class="score-value">{{level}}</text>
      </view>
      <view class="score">
        <text class="score-label">消行</text>
        <text class="score-value">{{lines}}</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="board-wrap">
      <view class="board">
        <view wx:for="{{rows}}" wx:for-item="row" class="board-row">
          <view wx:for="{{row}}" wx:for-item="c" class="cell {{c}}"></view>
        </view>
      </view>
    </view>

    <view class="panel">
      <view class="box">
        <text class="box-title">下一个</text>
        <view wx:for="{{nextRows}}" wx:for-item="row" class="mini-row">
          <view wx:for="{{row}}" wx:for-item="c" class="mini-cell {{c}}"></view>
        </view>
      </view>

      <view class="box">
        <text class="box-title">暂存（攒住）</text>
        <view wx:for="{{holdRows}}" wx:for-item="row" class="mini-row">
          <view wx:for="{{row}}" wx:for-item="c" class="mini-cell {{c}}"></view>
        </view>
      </view>

      <view class="keys">
        <button class="key" bindtap="onLeft">← 左移</button>
        <button class="key" bindtap="onRight">右移 →</button>
      </view>
      <view class="keys">
        <button class="key" bindtap="onRotate">旋转</button>
        <button class="key" bindtap="onDown">↓ 下移</button>
      </view>
      <view class="keys">
        <button class="key key-main" bindtap="onDrop">直落到底</button>
        <button class="key" bindtap="onHold">暂存</button>
      </view>
      <view class="keys">
        <button class="key" bindtap="onPause">{{pauseLabel}}</button>
        <button class="key key-warn" bindtap="onRestart">重新开始</button>
      </view>

      <view wx:if="{{over}}" class="overlay-box">
        <text class="overlay-title">堆到顶了</text>
        <text class="overlay-sub">本局 {{score}} 分 · 最高 {{best}} 分</text>
      </view>
      <view wx:elif="{{paused}}" class="overlay-box">
        <text class="overlay-title">已暂停</text>
        <text class="overlay-sub">按「继续」回到游戏</text>
      </view>
      <view wx:else class="hint">
        <text class="hint-line">每消 10 行升一级，下落会更快</text>
        <text class="hint-line">「直落到底」一次落满最划算</text>
        <text class="hint-line">「暂存」可以把当前方块攒起来后面用</text>
      </view>
    </view>
  </view>
</view>
