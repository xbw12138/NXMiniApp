/* 俄罗斯方块 —— 霓虹街机主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #0a0d12;
  padding: 16rpx 30rpx;
  color: #e8edf7;
}

.top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  height: 72rpx;
}

.brand {
  flex-direction: row;
  align-items: flex-end;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #f2f6ff;
  line-height: 1;
}

.subtitle {
  font-size: 20rpx;
  color: #6b7688;
  margin-left: 14rpx;
  margin-bottom: 4rpx;
}

.scores {
  flex-direction: row;
}

.score {
  width: 116rpx;
  height: 62rpx;
  margin-left: 10rpx;
  border-radius: 12rpx;
  background-color: #141a24;
  border: 2rpx solid #1f2836;
  align-items: center;
  justify-content: center;
}

.score-label {
  font-size: 17rpx;
  color: #6d798c;
  line-height: 1.2;
}

.score-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #8fd0ff;
  line-height: 1.2;
}

.body {
  flex-direction: row;
  flex: 1;
  align-items: flex-start;
  margin-top: 12rpx;
}

.board-wrap {
  width: 356rpx;
  height: 696rpx;
  padding: 8rpx;
  border-radius: 14rpx;
  background-color: #10151d;
  border: 2rpx solid #222c3b;
}

.board {
  width: 340rpx;
  height: 680rpx;
  flex-direction: column;
}

.board-row {
  flex-direction: row;
  width: 340rpx;
  height: 34rpx;
}

.cell {
  width: 34rpx;
  height: 34rpx;
  background-color: #0c1017;
  border: 1rpx solid #131923;
  border-radius: 4rpx;
}

.c1 { background-color: #22d3ee; border-color: #0e7490; }
.c2 { background-color: #facc15; border-color: #a16207; }
.c3 { background-color: #a855f7; border-color: #6b21a8; }
.c4 { background-color: #34d399; border-color: #047857; }
.c5 { background-color: #f87171; border-color: #991b1b; }
.c6 { background-color: #60a5fa; border-color: #1d4ed8; }
.c7 { background-color: #fb923c; border-color: #c2410c; }

.ghost { background-color: #1b2432; border-color: #2a3646; }

.panel {
  flex: 1;
  margin-left: 26rpx;
  flex-direction: column;
}

.box {
  border-radius: 14rpx;
  background-color: #10151d;
  border: 2rpx solid #222c3b;
  padding: 10rpx 14rpx 12rpx 14rpx;
  margin-bottom: 12rpx;
}

.box-title {
  font-size: 18rpx;
  color: #6d798c;
  margin-bottom: 6rpx;
}

.mini-row {
  flex-direction: row;
  height: 26rpx;
}

.mini-cell {
  width: 26rpx;
  height: 26rpx;
  margin: 1rpx;
  border-radius: 3rpx;
  background-color: transparent;
}

.mini-on {
  border-width: 1rpx;
  border-radius: 3rpx;
}

.keys {
  flex-direction: row;
  margin-top: 2rpx;
}

.key {
  flex: 1;
  height: 62rpx;
  margin: 0 4rpx 8rpx 4rpx;
  border-radius: 12rpx;
  background-color: #161d28;
  border: 2rpx solid #26313f;
  color: #cfdaea;
  font-size: 22rpx;
  padding: 0;
  line-height: 58rpx;
  text-align: center;
}

.key-main {
  background-color: #1d4ed8;
  border-color: #2563eb;
  color: #ffffff;
  font-weight: bold;
}

.key-warn {
  background-color: #3b1d2a;
  border-color: #7f2b45;
  color: #ffb3c7;
}

.hint {
  flex-direction: column;
  margin-top: 4rpx;
}

.hint-line {
  font-size: 18rpx;
  color: #5d6779;
  line-height: 1.7;
}

.overlay-box {
  margin-top: 6rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background-color: #1a1420;
  border: 2rpx solid #4c2b52;
  align-items: center;
}

.overlay-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #f0abfc;
}

.overlay-sub {
  font-size: 19rpx;
  color: #a08aa8;
  margin-top: 4rpx;
}
