<view class="page">
  <view class="top">
    <view class="brand">
      <text class="title">2048</text>
      <text class="subtitle">掌上合成 · 越合越大</text>
    </view>
    <view class="scores">
      <view class="score-card">
        <text class="score-label">得分</text>
        <text class="score-value">{{score}}</text>
      </view>
      <view class="score-card">
        <text class="score-label">最高分</text>
        <text class="score-value">{{best}}</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="board">
      <view wx:for="{{rows}}" wx:for-item="row" wx:key="r" class="board-row">
        <view wx:for="{{row.cells}}" wx:for-item="t" wx:key="i" class="tile {{t.cls}}"
              style="width: 138rpx; height: 138rpx;">{{t.label}}</view>
      </view>
    </view>

    <view class="panel">
      <view class="pad">
        <view class="pad-row">
          <view class="pad-gap"/>
          <button class="dir" bindtap="onUp">↑</button>
          <view class="pad-gap"/>
        </view>
        <view class="pad-row">
          <button class="dir" bindtap="onLeft">←</button>
          <button class="dir" bindtap="onDown">↓</button>
          <button class="dir" bindtap="onRight">→</button>
        </view>
      </view>

      <view class="actions">
        <button class="act" bindtap="onUndo">撤销 {{undoCount}}</button>
        <button class="act act-main" bindtap="onNew">重新开始</button>
      </view>

      <view wx:if="{{won}}" class="won-badge">
        <text class="won-text">已达成 2048，继续冲更高分</text>
      </view>

      <view wx:if="{{over}}" class="over-box">
        <text class="over-title">无路可走了</text>
        <text class="over-sub">本局得分 {{score}} · 最高分 {{best}}</text>
        <button class="over-btn" bindtap="onNew">再来一局</button>
      </view>

      <view wx:if="{{!over}}" class="hint">
        <text class="hint-line">点击右侧方向键移动方块</text>
        <text class="hint-line">相同数字合并，目标 2048</text>
        <text class="hint-line">进度会自动保存</text>
      </view>
    </view>
  </view>
</view>
