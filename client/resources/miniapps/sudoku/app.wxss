/* 数独 —— 深色专注主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #0f1117;
  padding: 32rpx 40rpx;
  color: #e9edf6;
}

.top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 24rpx;
}

.brand {
  flex-direction: row;
  align-items: flex-end;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #f3f6fb;
  line-height: 1;
}

.subtitle {
  font-size: 22rpx;
  color: #6f7a8d;
  margin-left: 16rpx;
  margin-bottom: 4rpx;
}

.diffs {
  flex-direction: row;
  align-items: center;
}

.diff {
  width: 130rpx;
  height: 62rpx;
  margin-left: 14rpx;
  border-radius: 31rpx;
  background-color: #181d28;
  border: 2rpx solid #262f40;
  color: #aeb8c8;
  font-size: 24rpx;
  padding: 0;
  line-height: 58rpx;
  text-align: center;
}

.diff-on {
  background-color: #2c4270;
  border-color: #4d7cff;
  color: #ffffff;
  font-weight: bold;
}

.body {
  flex-direction: row;
  flex: 1;
  align-items: flex-start;
}

.board {
  width: 632rpx;
  height: 650rpx;
  flex-direction: column;
  padding: 8rpx;
  border-radius: 18rpx;
  background-color: #141822;
  border: 2rpx solid #232b3a;
}

.row {
  flex-direction: row;
  height: 68rpx;
  flex-shrink: 0;
}

.cell {
  width: 64rpx;
  height: 64rpx;
  margin: 2rpx;
  border-radius: 6rpx;
  background-color: #1a202c;
  color: #dbe4f2;
  font-size: 30rpx;
  font-weight: bold;
  padding: 0;
  line-height: 64rpx;
  text-align: center;
}

.b1 { background-color: #1e2532; }
.given { background-color: #151a24; color: #7c8799; }
.sel { background-color: #2b3f63; border: 2rpx solid #4d7cff; }
.err { background-color: #3a2028; color: #ff7b7b; }
.hintv { color: #6ee7a8; }

.panel {
  flex: 1;
  margin-left: 48rpx;
  flex-direction: column;
}

.stats {
  flex-direction: row;
  margin-bottom: 26rpx;
}

.stat {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  background-color: #181d28;
  border: 2rpx solid #252d3c;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #737f92;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #e9eef8;
  line-height: 1.3;
}

.pad-title {
  font-size: 22rpx;
  color: #738095;
  margin-bottom: 12rpx;
}

.num-row {
  flex-direction: row;
}

.num {
  width: 116rpx;
  height: 98rpx;
  margin: 0 8rpx 12rpx;
  border-radius: 14rpx;
  background-color: #1a2130;
  border: 2rpx solid #283247;
  color: #eef3fb;
  font-size: 40rpx;
  font-weight: bold;
  padding: 0;
  line-height: 94rpx;
  text-align: center;
}

.tools {
  flex-direction: row;
  margin-top: 10rpx;
}

.tool {
  flex: 1;
  height: 84rpx;
  margin: 0 8rpx;
  border-radius: 14rpx;
  background-color: #202836;
  border: 2rpx solid #2b3648;
  color: #cdd7e6;
  font-size: 24rpx;
  padding: 0;
  line-height: 80rpx;
  text-align: center;
}

.tool-main {
  background-color: #4d7cff;
  border-color: #4d7cff;
  color: #ffffff;
  font-weight: bold;
}

.hint {
  font-size: 22rpx;
  color: #6f7a8d;
  line-height: 1.7;
  margin-top: 22rpx;
}

.loading {
  flex: 1;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #8b96a8;
}
