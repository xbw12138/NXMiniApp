<view class="page">
  <view class="top">
    <view class="brand">
      <text class="title">扫雷</text>
      <text class="subtitle">小心每一步</text>
    </view>
    <view class="diffs">
      <button wx:for="{{diffs}}" wx:key="key"
              class="diff {{level === item.key ? 'diff-on' : ''}}"
              data-key="{{item.key}}" bindtap="onLevel">{{item.label}}</button>
    </view>
  </view>

  <view class="body">
    <view class="board">
      <view wx:for="{{rows}}" wx:for-item="row" wx:key="r" class="board-row">
        <button wx:for="{{row.cells}}" wx:for-item="c" wx:key="i"
                class="{{c.cls}}" data-i="{{c.i}}" bindtap="onCell">{{c.label}}</button>
      </view>
    </view>

    <view class="panel">
      <view class="stats">
        <view class="stat">
          <text class="stat-label">剩余雷</text>
          <text class="stat-value">{{mineLeft}}</text>
        </view>
        <view class="stat">
          <text class="stat-label">用时</text>
          <text class="stat-value">{{timeText}}</text>
        </view>
        <view class="stat">
          <text class="stat-label">最好</text>
          <text class="stat-value">{{bestText}}</text>
        </view>
      </view>

      <button class="mode {{flagMode ? 'mode-on' : ''}}" bindtap="onToggleMode">
        {{flagMode ? '插旗模式 · 点击放旗' : '挖开模式 · 点击开格'}}
      </button>

      <button class="act" bindtap="onRestart">重新开始</button>

      <view wx:if="{{win}}" class="win-box">
        <text class="win-title">全部扫清！</text>
        <text class="win-sub">用时 {{timeText}}</text>
      </view>

      <view wx:if="{{over && !win}}" class="over-box">
        <text class="over-title">踩到雷了</text>
        <text class="over-sub">点「重新开始」再来一局</text>
      </view>

      <view class="hint">
        <text class="hint-line">数字表示周围 8 格的雷数</text>
        <text class="hint-line">切到插旗模式给疑似雷格做标记</text>
        <text class="hint-line">第一次点击永远不会踩雷</text>
      </view>
    </view>
  </view>
</view>
