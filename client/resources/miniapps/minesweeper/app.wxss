/* 扫雷 —— 深色简约主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  background-color: #0f1117;
  padding: 30rpx 40rpx;
  color: #e9edf6;
}

.top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 22rpx;
}

.brand {
  flex-direction: row;
  align-items: flex-end;
}

.title {
  font-size: 54rpx;
  font-weight: bold;
  color: #f4f7fb;
  line-height: 1;
}

.subtitle {
  font-size: 22rpx;
  color: #6f798a;
  margin-left: 16rpx;
  margin-bottom: 4rpx;
}

.diffs {
  flex-direction: row;
}

.diff {
  width: 128rpx;
  height: 62rpx;
  margin-left: 12rpx;
  border-radius: 31rpx;
  background-color: #191e28;
  border: 2rpx solid #262e3c;
  color: #a7b1c1;
  font-size: 24rpx;
  padding: 0;
  line-height: 58rpx;
  text-align: center;
}

.diff-on {
  background-color: #2b3f63;
  border-color: #4d7cff;
  color: #ffffff;
  font-weight: bold;
}

.body {
  flex-direction: row;
  flex: 1;
  align-items: flex-start;
}

.board {
  width: 632rpx;
  height: 632rpx;
  flex-direction: column;
  padding: 8rpx;
  border-radius: 18rpx;
  background-color: #141a24;
  border: 2rpx solid #232c3a;
}

.board-row {
  flex-direction: row;
  height: 61rpx;
  flex-shrink: 0;
}

.cell {
  width: 57rpx;
  height: 57rpx;
  margin: 2rpx;
  border-radius: 8rpx;
  background-color: #273040;
  color: #dbe4f2;
  font-size: 28rpx;
  font-weight: bold;
  padding: 0;
  line-height: 57rpx;
  text-align: center;
  border-width: 0;
}

.cell-open {
  background-color: #182029;
}

.cell-flag {
  background-color: #2c3550;
  color: #ffb066;
}

.cell-mine {
  background-color: #3a2028;
  color: #ff7b7b;
}

.cell-boom {
  background-color: #a8323a;
  color: #ffffff;
}

.n1 { color: #6aa9ff; }
.n2 { color: #5fd39a; }
.n3 { color: #ff8a8a; }
.n4 { color: #b48cff; }
.n5 { color: #ffb066; }
.n6 { color: #5fd9d3; }
.n7 { color: #d9dee6; }
.n8 { color: #9aa5b5; }

.panel {
  flex: 1;
  margin-left: 44rpx;
  flex-direction: column;
}

.stats {
  flex-direction: row;
  margin-bottom: 20rpx;
}

.stat {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  background-color: #181e28;
  border: 2rpx solid #252d3b;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #727d8f;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #f2f5fa;
  line-height: 1.3;
}

.mode {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  background-color: #1c2433;
  border: 2rpx solid #2b3648;
  color: #cfd8e6;
  font-size: 26rpx;
  padding: 0;
  line-height: 84rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.mode-on {
  background-color: #3a2a18;
  border-color: #ff9d3d;
  color: #ffd9b0;
  font-weight: bold;
}

.act {
  width: 100%;
  height: 80rpx;
  border-radius: 16rpx;
  background-color: #4d7cff;
  border: 2rpx solid #4d7cff;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 0;
  line-height: 76rpx;
  text-align: center;
}

.over-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background-color: #241a1c;
  border: 2rpx solid #4a2b30;
  align-items: center;
}

.over-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff9a8a;
}

.over-sub {
  font-size: 22rpx;
  color: #b08d95;
  margin-top: 8rpx;
}

.win-box {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background-color: #16261f;
  border: 2rpx solid #2b4a3a;
  align-items: center;
}

.win-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #6ee7a8;
}

.win-sub {
  font-size: 22rpx;
  color: #8fb3a2;
  margin-top: 8rpx;
}

.hint {
  flex-direction: column;
  margin-top: 22rpx;
}

.hint-line {
  font-size: 21rpx;
  color: #6b7587;
  line-height: 1.8;
}
