/* 科学计算器 —— 深色专业主题 */
.page {
  width: 100%;
  height: 100%;
  flex-direction: row;
  background-color: #0f1117;
  padding: 30rpx 40rpx;
  color: #eceff5;
}

.left {
  flex: 1;
  flex-direction: column;
  margin-right: 36rpx;
}

.title-row {
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
  margin-bottom: 18rpx;
}

.title {
  font-size: 50rpx;
  font-weight: bold;
  color: #f5f7fb;
  line-height: 1;
}

.subtitle {
  font-size: 21rpx;
  color: #6f798a;
}

.display {
  flex: 1;
  border-radius: 22rpx;
  background-color: #161b23;
  border: 2rpx solid #232b38;
  padding: 28rpx 30rpx;
  flex-direction: column;
}

.display-top {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.angle {
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background-color: #1f2836;
  border: 2rpx solid #2c3849;
  align-items: center;
  justify-content: center;
}

.angle-text {
  font-size: 20rpx;
  color: #8fb6ff;
  letter-spacing: 2rpx;
}

.prev {
  font-size: 21rpx;
  color: #6d7889;
}

.expr-wrap {
  flex: 1;
  justify-content: center;
  align-items: flex-end;
}

.expr {
  font-size: 44rpx;
  color: #dfe7f4;
  text-align: right;
  line-height: 1.4;
}

.result-wrap {
  flex-shrink: 0;
  align-items: flex-end;
}

.result {
  font-size: 66rpx;
  font-weight: bold;
  color: #ffb066;
  text-align: right;
}

.result-err {
  color: #ff7b7b;
  font-size: 40rpx;
}

.right {
  width: 636rpx;
  flex-direction: column;
}

.key-row {
  flex-direction: row;
  height: 82rpx;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.key {
  flex: 1;
  height: 82rpx;
  margin: 0 5rpx;
  border-radius: 14rpx;
  background-color: #1b222d;
  border: 2rpx solid #28313f;
  color: #e6edf8;
  font-size: 30rpx;
  padding: 0;
  line-height: 78rpx;
  text-align: center;
}

.key-fn {
  background-color: #17202b;
  color: #9fb2c9;
  font-size: 26rpx;
}

.key-op {
  background-color: #22303f;
  border-color: #2f4256;
  color: #9fc4ff;
}

.key-amber {
  background-color: #3a2a18;
  border-color: #6b4a20;
  color: #ffcb8a;
}

.key-eq {
  background-color: #ff8a3d;
  border-color: #ff8a3d;
  color: #241202;
  font-weight: bold;
}

.key-clear {
  background-color: #3a2028;
  border-color: #5c2f3a;
  color: #ff9a8a;
  font-weight: bold;
}

.tip {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #616b7b;
  text-align: center;
}
