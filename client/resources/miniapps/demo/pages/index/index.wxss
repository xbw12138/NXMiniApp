.page {
  background-color: #141518;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 64rpx;
  padding-bottom: 40rpx;
}

.header {
  width: 660rpx;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.brand-row {
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.brand-text {
  flex-direction: column;
}

.title {
  color: #F5F6F7;
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1.12;
}

.subtitle {
  color: #8A9099;
  font-size: 26rpx;
  margin-top: 10rpx;
}

.badge {
  background-color: #0FDC78;
  color: #0B1A12;
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.card {
  width: 660rpx;
  background-color: #1F2125;
  border-radius: 24rpx;
  border: 1rpx solid #2A2D33;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
  margin-bottom: 24rpx;
}

.row {
  height: 88rpx;
  flex-direction: row;
  align-items: center;
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.row-main {
  flex-direction: column;
  justify-content: center;
}

.row-name {
  color: #E9EBEF;
  font-size: 30rpx;
  font-weight: bold;
}

.row-desc {
  color: #8A9099;
  font-size: 22rpx;
  margin-top: 2rpx;
}

.footer {
  color: #6F757E;
  font-size: 22rpx;
  text-align: center;
  margin-top: 4rpx;
  margin-bottom: 26rpx;
}

.start {
  width: 320rpx;
  height: 88rpx;
  background-color: #0FDC78;
  color: #0B1A12;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
}
