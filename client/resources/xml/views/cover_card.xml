<brls:Box
        wireframe="false"
        highlightCornerRadius="8"
        axis="column"
        width="auto"
        height="auto"
        backgroundColor="#1B1E24"
        cornerRadius="10">
    <brls:Box
            id="cover/card/pic_box"
            width="100%"
            height="66%"
            cornerRadius="10">
        <brls:Image
                id="cover/card/picture"
                backgroundColor="@theme/color/grey_1"
                scalingType="fill"
                height="100%"
                width="100%"
                image="@res/pictures/cover-bg.png"
                cornerRadius="10"/>

        <brls:Box
                positionBottom="8"
                positionLeft="8"
                positionType="absolute"
                paddingLeft="6"
                paddingRight="6"
                paddingTop="1"
                paddingBottom="1"
                backgroundColor="#000000B3"
                cornerRadius="4"
                width="auto"
                height="auto">
            <brls:Label
                    id="cover/card/label/badge"
                    textColor="#FFFFFF"
                    fontSize="15"/>
        </brls:Box>
    </brls:Box>

    <brls:Box
            margin="8"
            axis="column"
            width="auto"
            height="auto"
            paddingBottom="8">
        <TextBox
                id="cover/card/label/title"
                fontSize="20"
                lineHeight="1.4"
                maxRows="2"
                width="100%"
                height="56"/>
        <brls:Label
                id="cover/card/label/subtitle"
                marginTop="2"
                fontSize="16"
                singleLine="true"
                textColor="@theme/font/grey"
                height="20"/>
    </brls:Box>
</brls:Box>
